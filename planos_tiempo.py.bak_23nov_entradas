def cortes_posibles(s, L):
    if L < 1.8: return []
    ws = [w for w in PAL if s - 0.1 <= w["i"] < s + 2.8]
    txt = " ".join(w["w"].lower() for w in ws)
    out = []
    for n, (st, kws, op, pr) in CORTES.items():
        if n in ult_corte: continue          # regla: cada inserto una sola vez (los recuerdos a proposito van a mano en b.py)
        pos = [m.start() for k in kws for m in [re.search(r"(^|\W)" + re.escape(k) + r"(\W|$)", txt)] if m]
        if pos: out.append((n, st, dict(op), pr, min(pos)))
    for w in ws:
        m = ANIO.match(w["w"])
        if m and "anio" + m.group(1) not in ult_corte and N_ANIOS[0] < 3 and s - max([v for kk, v in ult_corte.items() if kk.startswith("anio")] + [-99]) > 45:
            y = int(m.group(1)); out.append(("anio" + m.group(1), "lineaTiempoH", {"anio": y, "desde": anio_prev[0] or y - 6}, 2, txt.find(m.group(1)))); break
    if not out: return []
    top = max(o[3] for o in out); out = [o for o in out if o[3] == top]; TOPP[0] = top   # la idea mas especifica gana
    pri = min(o[4] for o in out)
    return [o[:3] for o in out if o[4] == pri]                           # y si empatan, la que se dice primero


