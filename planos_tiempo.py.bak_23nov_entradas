def res(k):
    if isinstance(k, (int, float)): return float(k)
    if k in T: return float(T[k])
    m = re.match(r"^(.*?)([+-]\d+(?:\.\d+)?)$", str(k))
    if m and m.group(1) in T: return float(T[m.group(1)]) + float(m.group(2))
    return None


