def gesticular(ac, cur, x, otro, s, f, reaccion):
    """El personaje hace un gesto hacia el otro (apunta / ofrece / saluda) y vuelve a como estaba; el otro a veces reacciona."""
    xo = estado(otro, s)[1]; dr = 1 if xo > x else -1
    pose = GESTOS[cnt["gesto"] % len(GESTOS)]; cnt["gesto"] += 1
    base = {kk: v for kk, v in cur.items() if kk not in ("a", "dur", "ease", "fx", "k", "_t")}
    meter_key(ac, dict(base, k=round(s + 0.35, 3), x=round(x), y=SUELO, pose=pose, dir=dr, _t=s + 0.35))
    meter_key(ac, dict(base, k=round(f - 0.12, 3), x=round(x), y=SUELO, _t=f - 0.12))
    if reaccion:
        c2, x2, _ = estado(otro, s); b2 = {kk: v for kk, v in c2.items() if kk not in ("a", "dur", "ease", "fx", "k", "_t")}
        meter_key(otro, dict(b2, k=round(s + 0.95, 3), x=round(x2), y=SUELO, pose=REACC[cnt["gesto"] % 2], dir=-dr, _t=s + 0.95))
        meter_key(otro, dict(b2, k=round(f - 0.1, 3), x=round(x2), y=SUELO, _t=f - 0.1))
    return pose


