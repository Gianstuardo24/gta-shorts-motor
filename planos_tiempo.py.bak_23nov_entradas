def estado(a, t):
    cur = None
    for kk in a["keys"]:
        if kk["_t"] is not None and t >= kk["_t"]: cur = kk
    if cur is None: cur = a["keys"][0]
    x = cur["a"][0] if cur.get("a") else cur["x"]
    mov = bool(cur.get("a")) and t < (cur["_t"] or 0) + cur.get("dur", 1.2)
    return cur, x, mov


def visibles(t, lo, hi):
