    GAPS.append(((a["f"] + b["i"]) / 2, 3 if w[-1:] in ".!?:" else 2 if w[-1:] in ",;" else 1))


def snap(obj, lo, hi, eventos=()):
    """Mejor punto de corte cerca de obj dentro de [lo,hi]: evento > fin de frase > coma > entre palabras."""
    best, bs = None, -1e9
    for tg, w in list(GAPS) + [(ev, 4) for ev in eventos]:
        if lo <= tg <= hi:
            sc = w - abs(tg - obj) * 1.1
            if sc > bs: best, bs = tg, sc
    return best if best is not None else obj


