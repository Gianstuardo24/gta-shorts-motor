"""Planos por tiempo real de la voz: un encuadre nuevo cada ~3-4 s, elegido segun lo que pasa en ese momento.
Uso: python3 planos_tiempo.py guion.json datos0.json   (modifica guion.json; correr despues de recortar_insertos)
- Corta en pausas de la voz (fin de frase > coma > entre palabras) o justo cuando aparece un objeto / un personaje cambia de accion.
- Tipos: general, medio, primer, dos, holandes (inclinado), objeto (camara al objeto), camina (cruza y la camara lo sigue),
  detalle (corte a manos: teclado / telefono / papeles / billetes segun las palabras dichas).
- Plano general obligado mientras hay cifra grande, titulo grande o globo de dialogo en pantalla.
- Mezcla cortes secos y acercamientos lentos; nunca el mismo tipo dos veces seguidas.
- Respeta e["planos_hint"]: [{"k":clave,"tipo":"primer","var":301,"push":1}] (fuerza un plano en ese momento)."""
import json, sys, os, re, random

fj, fd = sys.argv[1:3]
g = json.load(open(fj)); T = json.load(open(fd))["T"]
e = g["escena"]["escenas"][0]
PAL = json.load(open(os.path.join(os.path.dirname(os.path.abspath(fj)), "vz_palabras.json")))
R = random.Random(11)
ANCHO, SUELO = 2200, 1700
FIN = PAL[-1]["f"] + 0.3


def res(k):
    if isinstance(k, (int, float)): return float(k)
    if k in T: return float(T[k])
    m = re.match(r"^(.*?)([+-]\d+(?:\.\d+)?)$", str(k))
    if m and m.group(1) in T: return float(T[m.group(1)]) + float(m.group(2))
    return None


# ---------- huecos de la voz ----------
GAPS = []
for a, b in zip(PAL, PAL[1:]):
    w = a["w"].rstrip('"\'')
    GAPS.append(((a["f"] + b["i"]) / 2, 3 if w[-1:] in ".!?:" else 2 if w[-1:] in ",;" else 1))


def snap(obj, lo, hi, eventos=()):
    """Mejor punto de corte cerca de obj dentro de [lo,hi]: evento > fin de frase > coma > entre palabras."""
    best, bs = None, -1e9
    for tg, w in list(GAPS) + [(ev, 4) for ev in eventos]:
        if lo <= tg <= hi:
            sc = w - abs(tg - obj) * 1.1
            if sc > bs: best, bs = tg, sc
    return best if best is not None else obj


# ---------- tramos en pantalla (segmentos de camara quieta) ----------
pans = sorted([p for p in e["pan"] if res(p["k"]) is not None], key=lambda p: res(p["k"]))
segs = []
for i, p in enumerate(pans):
    a = res(p["k"]); b = res(pans[i + 1]["k"]) if i + 1 < len(pans) else FIN
    if p["x"] >= 99000: continue
    llega = "corte" if p.get("corte") else "paneo"
    if not p.get("corte"): a += (p.get("dur", 1.0) * 1.6) * 0.7
    prev_ins = i > 0 and pans[i - 1]["x"] >= 99000
    sale_ins = i + 1 < len(pans) and pans[i + 1]["x"] >= 99000
    if b - a > 0.6: segs.append({"a": a, "b": b, "x": p["x"], "llega": llega, "vuelve": prev_ins, "sale": sale_ins})

# ---------- cosas en pantalla ----------
def iv(o, dfin=99):
    a = res(o.get("k")); f = res(o["fin"]) if o.get("fin") is not None else None
    return (a, f if f is not None else (a + dfin if a is not None else None))

DURO = []
for n in e.get("numeros", []): DURO.append(iv(n, 4))
for t in e.get("titulos", []):
    if t.get("grande"): DURO.append(iv(t, 3))
for bb in e.get("burbujas", []): DURO.append(iv(bb, 2.5))
DURO = [d for d in DURO if d[0] is not None]
PROPS = [p for p in e.get("props", []) if p.get("x", 0) < 99000 and res(p.get("k")) is not None]
for p in PROPS: p["_a"], p["_f"] = iv(p, 99)
ACT = [a for a in e.get("actores", []) if a.get("keys")]
for a in ACT:
    for kk in a["keys"]: kk["_t"] = res(kk.get("k"))
    a["_d"] = res(a.get("desde", 0)) or 0; a["_h"] = res(a.get("hasta")) if a.get("hasta") else FIN


def estado(a, t):
    cur = None
    for kk in a["keys"]:
        if kk["_t"] is not None and t >= kk["_t"]: cur = kk
    if cur is None: cur = a["keys"][0]
    x = cur["a"][0] if cur.get("a") else cur["x"]
    mov = bool(cur.get("a")) and t < (cur["_t"] or 0) + cur.get("dur", 1.2)
    return cur, x, mov


def visibles(t, lo, hi):
    return [a for a in ACT if a["_d"] <= t < a["_h"] and lo - 50 <= estado(a, t)[1] <= hi + 50]


KW = {"billetesH": ["million", "billion", "money", "dollars", "cash", "paid", "pay", "price", "bought", "worth", "rich"],
      "papelesH": ["deal", "contract", "signed", "sign", "agreement", "lawyer", "divorce", "terms", "shares", "stock", "sell", "sale", "sold"],
      "telefonoH": ["call", "called", "phone", "offer", "offered", "asked", "told", "news", "warned", "convinced"],
      "manosTeclado": ["computer", "computers", "software", "code", "render", "pixel", "machine", "program", "tools", "animated", "animation", "graphics"]}


def palabras(a, b):
    return " ".join(w["w"].lower() for w in PAL if a <= w["i"] < b)


# ---------- insertos de detalle ----------
XI = max([z["x0"] + 100 for z in e["zonas"] if z["x0"] >= 99000] + [100000]) + 2600
TRD = ["seco", "seco", "luz", "seco", "lineas", "seco"]
ndet = 0


def detalle(s, d, st, manga, home):
    global XI, ndet
    e["zonas"].append({"x0": XI - 100, "x1": XI + ANCHO + 100, "set": st, "o": {"k": round(s, 3), "manga": manga}})
    tr = TRD[ndet % len(TRD)]; ndet += 1
    e["pan"].append({"k": round(s, 3), "x": XI + 437, "dur": 0.04, "corte": 1, "tr": tr})
    e["pan"].append({"k": round(s + d, 3), "x": home, "dur": 0.04, "corte": 1, "dir": 1, "tr": "seco"})
    mv = R.choice(["acerca", "fijo", "sube", "acerca", "baja"])
    Z = {"acerca": [(1.0, 0.01, 1200), (1.07, d, 1250)], "fijo": [(1.0, 0.01, 1200)], "sube": [(1.07, 0.01, 1290), (1.07, d, 1220)],
         "baja": [(1.07, 0.01, 1220), (1.07, d, 1290)]}[mv]
    for j, (sz, du, y) in enumerate(Z):
        NZ.append({"k": round(s + 0.02 * j, 3), "s": sz, "dur": du, "y": y})
    XI += 2600


# ---------- planificar ----------
NZ, usados, hist, LOG = [], [], [], []
hints = [dict(h, _t=res(h["k"])) for h in e.get("planos_hint", []) if res(h["k"]) is not None]
ult_det, nhol = -9, 0
cuenta = {}
for sg in segs:
    a, b, camx = sg["a"], sg["b"], sg["x"]
    lo, hi = camx - 437, camx - 437 + 1950
    cl = lambda x, s: max(lo + 975 / s, min(hi - 975 / s, x))
    ev = sorted({p["_a"] - 0.05 for p in PROPS if a + 1.2 < p["_a"] < b - 1.0 and lo <= p["x"] <= hi} |
                {kk["_t"] - 0.05 for ac in ACT for kk in ac["keys"] if kk["_t"] and a + 1.2 < kk["_t"] < b - 1.0 and ac["_d"] <= kk["_t"] < ac["_h"]})
    fijos = [h["_t"] - 0.05 for h in hints if a + 0.8 < h["_t"] < b - 1.2]
    cortes, t = [a], a
    while True:
        nxt = [f for f in fijos if f > t + 0.8]
        if nxt and nxt[0] < t + 4.6:
            t = nxt[0]
        else:
            L = R.uniform(2.9, 4.0)
            t = snap(t + L, t + 2.4, min(t + 4.6, b - 1.2), [x for x in ev if x > t + 2.0])
        if t >= b - 1.2: break
        cortes.append(t)
    i = 0
    while i < len(cortes):
        s = cortes[i]; f = cortes[i + 1] if i + 1 < len(cortes) else b; L = f - s
        vis = visibles(s + 0.1, lo, hi)
        hint = next((h for h in hints if abs(h["_t"] - 0.05 - s) < 0.06 or (i == 0 and a - 0.2 <= h["_t"] < a + 0.85)), None)
        duro = any(d0 < f and d1 > s for d0, d1 in DURO)
        aparece = [p for p in PROPS if s - 0.3 <= p["_a"] < s + 1.0 and lo <= p["x"] <= hi]
        pv = [p for p in PROPS if p["_a"] <= s + 0.2 < p["_f"] and lo <= p["x"] <= hi]
        prev = hist[-1] if hist else None
        # actor "activo": el que acaba de cambiar de accion (o la cambia pronto)
        def activo():
            best, bt = None, -1e9
            for ac in vis:
                for kk in ac["keys"]:
                    if kk["_t"] is not None and kk["_t"] <= s + 1.5 and kk["_t"] > bt and kk["_t"] >= s - 3: best, bt = ac, kk["_t"]
            return best or (vis[(len(hist) // 2) % len(vis)] if vis else None)
        foco = activo()
        if hint:
            tipo = hint["tipo"]; foco = next((ac for ac in vis if ac.get("var") == hint.get("var")), foco)
        elif duro:
            tipo = "recorre" if prev != "recorre" and L > 2.0 else "general"
        elif i == 0 and sg["llega"] == "paneo":
            tipo = "general"
        elif aparece:
            tipo = R.choices(["objeto", "general"], [3, 1])[0]
        else:
            c = {"medio": 3, "primer": 2, "dos": 2, "holandes": 1.3, "camina": 2.2, "detalle": 6.0, "objeto": 1.6, "general": 1.0}
            if len(vis) < 2 or abs(estado(vis[0], s)[1] - estado(vis[-1], s)[1]) > 1950 / 1.2 - 300: c.pop("dos", None)
            if not vis: [c.pop(x, None) for x in ("medio", "primer", "holandes", "camina", "dos")]
            if not pv: c.pop("objeto", None)
            txt = palabras(s, s + 2.6)
            det = [st for st, ws in KW.items() if any(re.search(r"(^|\W)" + re.escape(w) + r"(\W|$)", txt) for w in ws)]
            if not det or L < 1.7 or len(hist) - ult_det < 5 or not vis: c.pop("detalle", None)
            if (i == 0 and sg["vuelve"]) or (f >= b - 0.01 and sg["sale"]): c.pop("detalle", None)   # nunca inserto pegado a otro inserto
            libres = []
            for ac in vis:
                cur, x, mov = estado(ac, s)
                if mov or cur.get("objeto") or cur.get("pose") in ("sentado", "juega") or cur.get("fx"): continue
                if any(kk["_t"] and s - 0.3 < kk["_t"] < f + 0.2 for kk in ac["keys"]): continue
                libres.append((ac, cur, x))
            if not libres or L < 1.8: c.pop("camina", None)
            if prev: c.pop(prev, None)
            if prev in ("medio", "holandes"): c.pop("holandes" if prev == "medio" else "medio", None)
            if len(hist) > 1 and {hist[-1], hist[-2]} <= {"medio", "primer", "holandes"}:
                for x in ("medio", "primer", "holandes"): c.pop(x, None)
            for x in c: c[x] = c[x] / (1 + 0.04 * cuenta.get(x, 0))
            if "detalle" in c and R.random() < 0.7: tipo = "detalle"
            else:
                c.pop("detalle", None)
                tipo = R.choices(*zip(*c.items()))[0] if c else "general"
        hist.append(tipo); cuenta[tipo] = cuenta.get(tipo, 0) + 1
        LOG.append(f"{s:7.2f}-{f:7.2f} {tipo:9s} foco={foco.get('var') if foco else None} vis={[v.get('var') for v in vis]} seg={sg['a']:.2f}")
        ax = estado(foco, s)[1] if foco else lo + 975
        push = (hint and hint.get("push")) or R.random() < 0.38
        if tipo == "detalle":
            ult_det = len(hist)
            st = R.choice([x for x in det if x not in usados[-2:]] or det); usados.append(st)
            d = round(min(2.2, max(1.6, L if L < 2.6 else 2.0)), 2)
            if L > d + 1.6:          # vuelve a la escena en una pausa y sigue con otro plano
                r = snap(s + d, s + 1.6, s + 2.4)
                cortes.insert(i + 1, r); d = r - s
            else:
                d = L
            detalle(s, d, st, (foco or vis[0]).get("camisa", "#455a64"), camx)
            i += 1; continue
        if tipo == "camina":
            ac, cur, rest = R.choice(libres); dr = cur.get("dir", 1)
            x0 = max(lo + 160, min(hi - 160, rest - dr * 400))
            if abs(x0 - rest) >= 220:
                D = round(min(2.7, max(1.4, L - 0.3)), 2)
                nk = {"k": round(s, 3), "x": round(x0), "y": SUELO, "a": [rest, SUELO], "dur": D, "ease": "eio", "dir": dr,
                      "pose": cur.get("pose", "parado"), "cara": cur.get("cara", "feliz"), "_t": s}
                pos = next((n for n, kk in enumerate(ac["keys"]) if (kk["_t"] or 0) > s), len(ac["keys"]))
                ac["keys"].insert(pos, nk)
                NZ.append({"k": round(s, 3), "s": 1.3, "x": round(cl(x0 + dr * 150, 1.3)), "y": 1330, "dur": 0.01})
                NZ.append({"k": round(s + 0.03, 3), "s": 1.3, "x": round(cl(rest + dr * 150, 1.3)), "y": 1330, "dur": D})
                i += 1; continue
            tipo = "medio"; hist[-1] = "medio"
        r = 0
        if tipo == "holandes":
            nhol += 1; r = 0.045 if nhol % 2 else -0.045
        if tipo == "recorre":
            nrec = cuenta.get("recorre", 0); dx = 110 if nrec % 2 else -110
            NZ.append({"k": round(s, 3), "s": 1.12, "x": round(cl(lo + 975 - dx, 1.12)), "y": 1230, "dur": 0.01})
            NZ.append({"k": round(s + 0.03, 3), "s": 1.12, "x": round(cl(lo + 975 + dx, 1.12)), "y": 1230, "dur": round(L - 0.1, 2)})
            i += 1; continue
        if tipo == "objeto":
            p = (aparece or pv)[0]; ps = p.get("s", 1)
            S, X, Y = 1.38, p["x"], max(1150, min(1420, p.get("y", SUELO) - 110 * ps))
        elif tipo == "dos" and len(vis) >= 2:
            xs = [estado(ac, s)[1] for ac in vis]; S, X, Y = 1.2, (min(xs) + max(xs)) / 2, 1350
        else:
            S, X, Y = {"general": (1.0, lo + 975, 1200), "medio": (1.32, ax, 1330), "holandes": (1.32, ax, 1330),
                       "primer": (1.8, ax, 1265), "dos": (1.32, ax, 1330)}.get(tipo, (1.0, lo + 975, 1200))
        z = {"k": round(s, 3), "s": S, "x": round(cl(X, S)), "y": Y, "dur": 0.01}
        if r: z["r"] = r
        NZ.append(z)
        if push and L > 1.5 and tipo != "general" or (push and tipo == "general" and not duro and L > 2):
            S2 = min(S * 1.1, 2.0)
            z2 = {"k": round(s + 0.03, 3), "s": round(S2, 3), "x": round(cl(X, S2)), "y": Y, "dur": round(L - 0.1, 2)}
            if r: z2["r"] = r * 1.4
            NZ.append(z2)
        i += 1

# limpiar campos internos
for a in ACT:
    for kk in a["keys"]: kk.pop("_t", None)
    a.pop("_d", None); a.pop("_h", None)
for p in PROPS: p.pop("_a", None); p.pop("_f", None)
# quitar zooms viejos que caen dentro de un tramo en pantalla (p.ej. el "vuelve a 1.0" original de un inserto ya recortado):
# los planos nuevos definen el encuadre en todo el tramo
dentro = lambda t: t is not None and any(sg["a"] + 0.05 < t < sg["b"] - 0.05 for sg in segs)
viejos = e.get("zoom", [])
quit = [z for z in viejos if dentro(res(z["k"]))]
e["zoom"] = [z for z in viejos if z not in quit] + NZ
print("zooms viejos quitados", len(quit))
e.pop("planos_hint", None)
json.dump(g, open(fj, "w"), ensure_ascii=False)
open("/tmp/planos_log.txt", "w").write("\n".join(LOG))
print("planos", len(hist), dict(sorted(cuenta.items(), key=lambda x: -x[1])), "detalles", ndet,
      "promedio %.1fs" % (sum(sg["b"] - sg["a"] for sg in segs) / max(1, len(hist))))
