<!DOCTYPE html>
<html><head><meta charset="utf-8">
<style>
@font-face{font-family:P;src:url(Poppins-Bold.ttf);font-weight:700}
@font-face{font-family:P;src:url(Poppins-Regular.ttf);font-weight:400}
html,body{margin:0;background:#000}canvas{display:block}
</style></head><body>
<canvas id="c" width="1080" height="1920"></canvas>
<script>
const C=document.getElementById('c'),X=C.getContext('2d'),W=1080,H=1920;
const ROSA='#ff2d95',CIAN='#00e5ff',AMAR='#ffd23f',VERDE='#5effa1',ROJO='#ff3b5c',ORO='#ffb800';
// ---------- utilidades ----------
const cl=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));
const seg=(t,a,b)=>cl((t-a)/(b-a));
const eo=t=>1-Math.pow(1-t,3), eio=t=>t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;
const back=t=>{const s=1.7;t-=1;return t*t*((s+1)*t+s)+1};
const lerp=(a,b,t)=>a+(b-a)*t;
function rnd(i){const x=Math.sin(i*127.1+311.7)*43758.5453;return x-Math.floor(x)}
function glow(col,blur,fn){X.save();X.shadowColor=col;X.shadowBlur=blur;fn();X.restore()}
function add(fn){X.save();X.globalCompositeOperation='lighter';fn();X.restore()}
function txt(s,x,y,size,col,{w=700,al='center',bl='middle',g=0,gc=null,a=1}={}){
  X.save();X.globalAlpha*=a;X.font=`${w} ${size}px P`;X.textAlign=al;X.textBaseline=bl;X.fillStyle=col;
  if(g){X.shadowColor=gc||col;X.shadowBlur=g;X.fillText(s,x,y);X.shadowBlur=g/2;}
  X.fillText(s,x,y);X.restore()}
function rr(x,y,w,h,r){X.beginPath();X.roundRect(x,y,w,h,r)}

// ---------- guion (tiempos aproximados de la voz) ----------
let FRASES=[{a:0,b:99,t:'(sin datos)',k:[],w:[]}];
let T0={paises:2.6,tiendas:3.4,s2:4.2,moneda:5.8,s3:7.3,xbox:7.9,ps:10.9,amazon:14.6,tres:16.4,s4:19,ar_xbox:20.5,ar_ps:22.5,s5:24,cambia:25.5,s6:27,fin:30};
let MARCA='VICEVERSO GG';
let T=T0;var ACENTO=ROSA;if(window.DATOS){if(DATOS.acento)ACENTO=DATOS.acento;FRASES=DATOS.frases;T=DATOS.T;MARCA=DATOS.marca||MARCA}
let DUR=T.fin;

// ---------- mundo: cielo, sol, ciudad, palmeras, grilla ----------
const EDIF=[...Array(26)].map((_,i)=>({x:i*48-40+rnd(i)*20,w:40+rnd(i+5)*46,h:140+rnd(i+9)*380}));
const BOKEH=[...Array(46)].map((_,i)=>({x:rnd(i+1)*W,y:rnd(i+40)*H,r:6+rnd(i+80)*34,c:[ROSA,CIAN,AMAR,'#a259ff'][i%4],v:.2+rnd(i+7)}));
function mundo(t,cam){
  const hz=1180+cam.y*.3;                         // horizonte
  const g=X.createLinearGradient(0,0,0,hz);
  g.addColorStop(0,'#05020d');g.addColorStop(.55,'#1a0633');g.addColorStop(.85,'#5a0f4f');g.addColorStop(1,'#ff4f7b');
  X.fillStyle=g;X.fillRect(0,0,W,hz);
  // estrellas del cielo
  add(()=>{for(let i=0;i<90;i++){const a=.25+.75*Math.abs(Math.sin(t*1.3+i));X.fillStyle=`rgba(255,255,255,${a*.6})`;X.fillRect(rnd(i)*W,rnd(i+300)*hz*.7,2,2)}});
  // sol synthwave con franjas
  X.save();const sx=540+cam.x*.15,sy=hz-60,sr=250;
  glow('#ff5aa0',120,()=>{X.beginPath();X.arc(sx,sy,sr,0,Math.PI*2);const sg=X.createLinearGradient(0,sy-sr,0,sy+sr);sg.addColorStop(0,'#ffe35a');sg.addColorStop(.6,'#ff4f8b');sg.addColorStop(1,'#b0127a');X.fillStyle=sg;X.fill()});
  X.fillStyle='#2a0838';for(let i=0;i<7;i++){const y=sy+20+i*30+((t*30)%30);X.fillRect(sx-sr,y,sr*2,6+i*2.2)}
  X.restore();
  // reflectores que barren el cielo
  add(()=>{for(let i=0;i<3;i++){const ang=-Math.PI/2+Math.sin(t*.6+i*2.1)*.55,bx=200+i*340;
    const lg=X.createLinearGradient(bx,hz,bx+Math.cos(ang)*1400,hz+Math.sin(ang)*1400);lg.addColorStop(0,'rgba(0,229,255,.22)');lg.addColorStop(1,'rgba(0,229,255,0)');
    X.fillStyle=lg;X.beginPath();X.moveTo(bx,hz);X.lineTo(bx+Math.cos(ang-.05)*1600,hz+Math.sin(ang-.05)*1600);X.lineTo(bx+Math.cos(ang+.05)*1600,hz+Math.sin(ang+.05)*1600);X.fill()}});
  // edificios con ventanas
  for(const e of EDIF){const x=e.x+cam.x*.35,y=hz-e.h;X.fillStyle='#0b0418';X.fillRect(x,y,e.w,e.h);
    add(()=>{for(let wy=y+14;wy<hz-10;wy+=22)for(let wx=x+7;wx<x+e.w-8;wx+=14){const s=rnd(wx*7+wy);if(s>.62){const on=Math.sin(t*2+s*40)>-.6;X.fillStyle=on?(s>.9?'rgba(0,229,255,.75)':'rgba(255,200,120,.55)'):'rgba(255,200,120,.08)';X.fillRect(wx,wy,6,9)}}});
    X.fillStyle=e.h>420?ROSA:'transparent';if(e.h>420)glow(ROSA,20,()=>X.fillRect(x+e.w/2-2,y-26,4,26))}
  // piso: grilla en perspectiva que avanza
  X.fillStyle='#07020f';X.fillRect(0,hz,W,H-hz);
  add(()=>{X.strokeStyle='rgba(255,45,149,.55)';X.lineWidth=2;
    for(let i=-14;i<=14;i++){X.beginPath();X.moveTo(540+i*18+cam.x*.2,hz);X.lineTo(540+i*260+cam.x,H);X.stroke()}
    const off=(t*1.4)%1;for(let j=0;j<16;j++){const p=Math.pow((j+off)/16,2.2),y=hz+p*(H-hz);X.globalAlpha=.25+p*.75;X.beginPath();X.moveTo(0,y);X.lineTo(W,y);X.stroke()}});
  // estelas de luz de autos cruzando el piso
  add(()=>{for(let i=0;i<7;i++){const y=hz+120+i*90+rnd(i)*40,v=(600+rnd(i+3)*900)*(i%2?1:-1),L=260+rnd(i+5)*300;
    let x=((t*v+rnd(i+9)*3000)%(W+L*2+400));if(x<0)x+=W+L*2+400;x-=L+200;const col=i%2?'255,60,90':'255,230,170';
    const g=X.createLinearGradient(x,0,x+L,0);g.addColorStop(v>0?0:1,`rgba(${col},0)`);g.addColorStop(v>0?1:0,`rgba(${col},.9)`);
    X.fillStyle=g;X.fillRect(x,y,L,5+i*.8);X.globalAlpha=.35;X.fillRect(x,y-6,L,16+i);X.globalAlpha=1}});
  // reflejo del sol en el piso
  add(()=>{const rg=X.createRadialGradient(540,hz+40,10,540,hz+40,520);rg.addColorStop(0,'rgba(255,79,139,.45)');rg.addColorStop(1,'rgba(255,79,139,0)');X.fillStyle=rg;X.fillRect(0,hz,W,600)});
  // palmeras
  palmera(70+cam.x*.6,hz+140,1.25,t);palmera(1010+cam.x*.6,hz+170,1.4,t+1);palmera(940+cam.x*.5,hz+40,.8,t+2);
  // bokeh
  add(()=>{for(const b of BOKEH){const y=(b.y-t*40*b.v)%H;X.globalAlpha=.12+.1*Math.sin(t*2+b.x);const rg=X.createRadialGradient(b.x,(y+H)%H,0,b.x,(y+H)%H,b.r);rg.addColorStop(0,b.c);rg.addColorStop(1,'transparent');X.fillStyle=rg;X.beginPath();X.arc(b.x,(y+H)%H,b.r,0,7);X.fill()}});
}
function palmera(x,y,s,t){X.save();X.translate(x,y);X.scale(s,s);X.fillStyle='#030008';X.strokeStyle='#030008';
  X.lineWidth=16;X.beginPath();X.moveTo(0,0);X.quadraticCurveTo(30,-200,10,-420);X.stroke();
  for(let i=0;i<7;i++){const a=-Math.PI/2+(i-3)*.42+Math.sin(t*1.2+i)*.04;X.save();X.translate(10,-420);X.rotate(a);
    X.beginPath();X.moveTo(0,0);X.quadraticCurveTo(110,-40,190,30);X.quadraticCurveTo(100,-10,0,8);X.fill();X.restore()}X.restore()}

// ---------- piezas ----------
function estrellas(cx,cy,n,on,t){for(let i=0;i<n;i++){const x=cx+(i-(n-1)/2)*92,l=i<on;
  X.save();X.translate(x,cy);if(l){X.scale(1+.08*Math.sin(t*8+i),1+.08*Math.sin(t*8+i))}
  glow(l?ROJO:'#000',l?40:0,()=>{X.beginPath();for(let k=0;k<10;k++){const r=k%2?18:40,a=-Math.PI/2+k*Math.PI/5;X.lineTo(Math.cos(a)*r,Math.sin(a)*r)}X.closePath();X.fillStyle=l?ROJO:'rgba(255,255,255,.12)';X.fill()});X.restore()}}
function caja(cx,cy,rot,s,t,precio){ // estuche del juego (generico, sin logos oficiales)
  const w=360,h=470,sx=Math.cos(rot);X.save();X.translate(cx,cy);X.scale(s*sx,s);X.transform(1,Math.sin(rot)*.18,0,1,0,0);
  glow(ROSA,80,()=>{rr(-w/2,-h/2,w,h,22);X.fillStyle='#120420';X.fill()});
  rr(-w/2,-h/2,w,h,22);const g=X.createLinearGradient(0,-h/2,0,h/2);g.addColorStop(0,'#2b0b52');g.addColorStop(.6,'#ff3d8b');g.addColorStop(1,'#ffb347');X.fillStyle=g;X.fill();
  X.save();X.clip();X.fillStyle='rgba(20,0,30,.85)';for(let i=0;i<6;i++){const e=EDIF[i*3];X.fillRect(-w/2+i*62,h/2-90-e.h*.25,50,200)}
  add(()=>{const p=((t*.5)%1.6)-.3;const sg=X.createLinearGradient(-w/2+p*w*1.6,0,-w/2+p*w*1.6+120,0);sg.addColorStop(0,'rgba(255,255,255,0)');sg.addColorStop(.5,'rgba(255,255,255,.35)');sg.addColorStop(1,'rgba(255,255,255,0)');X.fillStyle=sg;X.fillRect(-w/2,-h/2,w,h)});X.restore();
  if(sx>0){txt('GTA',0,-80,120,'#fff',{g:30,gc:ROSA});txt('6',0,40,170,AMAR,{g:50,gc:ORO});}
  X.strokeStyle='rgba(255,255,255,.5)';X.lineWidth=3;rr(-w/2,-h/2,w,h,22);X.stroke();X.restore();
  if(precio!=null){ // etiqueta colgando
    const sw=Math.sin(t*3)*.08;X.save();X.translate(cx+170*s,cy-200*s);X.rotate(.25+sw);
    X.strokeStyle='#ddd';X.lineWidth=3;X.beginPath();X.moveTo(0,0);X.lineTo(40,70);X.stroke();X.translate(40,70);
    glow(AMAR,40,()=>{rr(-10,0,230,120,18);X.fillStyle='#1a1028';X.fill()});X.strokeStyle=AMAR;X.lineWidth=4;rr(-10,0,230,120,18);X.stroke();
    txt(precio,105,62,74,AMAR,{g:24});X.restore()}
}
function chip(x,y,lbl,col,a=1,s=1){X.save();X.globalAlpha*=a;X.translate(x,y);X.scale(s,s);X.font='700 38px P';const hw=Math.max(70,X.measureText(lbl).width/2+30);
  glow(col,30,()=>{rr(-hw,-34,hw*2,68,34);X.fillStyle='rgba(10,6,24,.9)';X.fill()});X.strokeStyle=col;X.lineWidth=4;rr(-hw,-34,hw*2,68,34);X.stroke();
  txt(lbl,0,3,38,col,{g:14});X.restore()}
function tarjeta(cx,cy,ang,s,{pais,col,valor,mon,etiqueta,tach,nuevo,pTach=0,pNuevo=0},t){
  X.save();X.translate(cx,cy);X.scale(s,s);X.transform(1,0,Math.tan(ang),1,0,0);
  const w=640,h=430;
  glow(col,90,()=>{rr(-w/2,-h/2,w,h,36);X.fillStyle='rgba(12,6,26,.92)';X.fill()});
  const lg=X.createLinearGradient(0,-h/2,0,h/2);lg.addColorStop(0,'rgba(255,255,255,.10)');lg.addColorStop(1,'rgba(255,255,255,0)');X.fillStyle=lg;rr(-w/2,-h/2,w,h,36);X.fill();
  X.strokeStyle=col;X.lineWidth=5;rr(-w/2,-h/2,w,h,36);X.stroke();
  add(()=>{const p=((t*.7)%2)-.5;const sg=X.createLinearGradient(-w/2+p*w,0,-w/2+p*w+160,0);sg.addColorStop(0,'rgba(255,255,255,0)');sg.addColorStop(.5,'rgba(255,255,255,.12)');sg.addColorStop(1,'rgba(255,255,255,0)');X.fillStyle=sg;rr(-w/2,-h/2,w,h,36);X.fill()});
  chip(-w/2+110,-h/2+70,pais,col,1,.95);
  txt(etiqueta,w/2-40,-h/2+70,40,'rgba(255,255,255,.75)',{al:'right'});
  if(tach){ // precio viejo que se tacha
    txt(tach,0,10,170,pNuevo>0?'rgba(255,255,255,.35)':'#fff',{g:pNuevo>0?0:30,gc:col});
    if(pTach>0){const L=430;add(()=>glow(ROJO,30,()=>{X.strokeStyle=ROJO;X.lineWidth=16;X.lineCap='round';X.beginPath();X.moveTo(-L/2,30);X.lineTo(-L/2+L*eo(pTach),-10);X.stroke()}))}
    if(pNuevo>0){const y=lerp(-500,150,back(cl(pNuevo)));txt(nuevo,140,y,150,VERDE,{g:50});}
  }else txt(valor,0,40,200,col===ORO?ORO:AMAR,{g:50,gc:col===ORO?ORO:AMAR});
  X.restore()}
function chispas(cx,cy,t0,t){const d=t-t0;if(d<0||d>1.2)return;add(()=>{for(let i=0;i<60;i++){const a=rnd(i)*Math.PI*2,v=300+rnd(i+9)*900,x=cx+Math.cos(a)*v*d,y=cy+Math.sin(a)*v*d+600*d*d;
  X.globalAlpha=cl(1-d/1.2);X.fillStyle=[AMAR,VERDE,'#fff'][i%3];X.fillRect(x,y,6,6)}})}
function haz(x,y,t,col){add(()=>{const g=X.createRadialGradient(x,y,0,x,y,520);g.addColorStop(0,col.replace(')',',.45)').replace('rgb','rgba'));g.addColorStop(1,'rgba(0,0,0,0)');X.fillStyle=g;X.fillRect(x-520,y-520,1040,1040)})}


function letrero(cx,cy,txtL,col,p,t,i,s=1){if(p<=0)return;const fl=(Math.sin(t*23+i*5)>.93&&t%3<1.2)?.35:1; // parpadeo de neon
  X.save();X.translate(cx,cy);X.scale(s*p,s*p);X.globalAlpha*=cl(p)*fl;X.font='700 40px P';const w=X.measureText(txtL).width+60;
  glow(col,50,()=>{rr(-w/2,-42,w,84,16);X.strokeStyle=col;X.lineWidth=6;X.stroke()});rr(-w/2,-42,w,84,16);X.fillStyle='rgba(8,4,18,.85)';X.fill();
  X.strokeStyle=col;X.lineWidth=5;X.stroke();txt(txtL,0,3,40,'#fff',{g:30,gc:col});
  add(()=>{const g=X.createRadialGradient(0,140,0,0,140,260);g.addColorStop(0,col+'55');g.addColorStop(1,'transparent');X.fillStyle=g;X.fillRect(-260,40,520,300)});X.restore()}
function lluvia(t,t0,a){if(a<=0)return;add(()=>{const S=['$','$','$','$'];for(let i=0;i<40;i++){const v=500+rnd(i)*700,x=rnd(i+3)*W,y=((t-t0)*v+rnd(i+7)*H)%(H+200)-100;
  X.globalAlpha=a*(.35+rnd(i+11)*.5);txt(S[i%4],x,y,40+rnd(i+5)*70,[VERDE,AMAR,CIAN][i%3],{g:20})}})}
// escaparate: las 3 tiendas de Mexico como columnas de luz; la altura = precio
const TIENDAS=[{n:'XBOX STORE',v:1499,c:VERDE,ap:'xbox',lbl:'$1.499'},{n:'PS STORE',v:1699,c:CIAN,ap:'ps',lbl:'+$200'},{n:'AMAZON · CAJA CON CÓDIGO',v:1799,c:AMAR,ap:'amazon',lbl:'$1.799'}];
function escaparate(t,out){const inn=eo(seg(t,T.s3,T.s3+.7));X.save();X.translate(-out*1100,0);
  chip(210,640,'MÉXICO',ROSA,inn,1.1);
  const base=1560,esc=.75;
  TIENDAS.forEach((s,i)=>{const ap=T[s.ap]-.15,p=seg(t,ap,ap+1.0);if(p<=0)return;const x=230+i*310,h=((s.v-1000)*esc+100)*eo(p);
    // columna de luz
    {const g=X.createLinearGradient(0,base-h,0,base);g.addColorStop(0,s.c);g.addColorStop(1,s.c+'55');X.fillStyle='#0a0616';X.fillRect(x-80,base-h,160,h);X.fillStyle=g;X.fillRect(x-80,base-h,160,h);
     X.fillStyle='rgba(255,255,255,.28)';X.fillRect(x-62,base-h+14,18,Math.max(0,h-28));
     X.fillStyle='rgba(0,0,0,.18)';for(let yy=base-h+30;yy<base;yy+=38)X.fillRect(x-80,yy,160,4)}
    add(()=>{
      const halo=X.createRadialGradient(x,base-h,0,x,base-h,260);halo.addColorStop(0,s.c+'88');halo.addColorStop(1,'transparent');X.fillStyle=halo;X.fillRect(x-260,base-h-260,520,520)});
    glow(s.c,40,()=>{X.fillStyle='#fff';X.fillRect(x-80,base-h,160,8)});
    // reflejo en el piso mojado
    add(()=>{const g=X.createLinearGradient(0,base,0,base+h*.6);g.addColorStop(0,s.c+'55');g.addColorStop(1,'transparent');X.fillStyle=g;X.fillRect(x-80,base+10,160,h*.6)});
    const n=i===1?Math.round(eo(seg(t,ap,ap+.8))*200):Math.round(1000+eo(seg(t,ap,ap+.8))*(s.v-1000));
    const lb=i===1?'+$'+n:'$'+n.toLocaleString('es-CL');
    X.save();X.font='700 76px P';const lw=X.measureText(lb).width+40;X.restore();
    rr(x-lw/2,base-h-120,lw,100,24);X.fillStyle='rgba(8,4,18,.8)';X.fill();
    txt(lb,x,base-h-68,i===1?72:76,i===1?ROJO:AMAR,{g:36});
    txt(s.n.split(' · ')[0],x,base+60,30,s.c,{g:12});
    if(s.n.includes('·'))txt('caja con código',x,base+98,24,'rgba(255,255,255,.7)',{w:400});
    chispas(x,base-h,ap+.8,t)});
  // "Trescientos mas que Xbox": linea entre Xbox y Amazon
  const d=seg(t,T.tres,T.tres+.6);if(d>0){const y1=base-(1499-1000)*esc-100,y2=base-(1799-1000)*esc-100;
    add(()=>glow(ROJO,30,()=>{X.strokeStyle=ROJO;X.lineWidth=8;X.setLineDash([22,14]);X.beginPath();X.moveTo(230,y1);X.lineTo(lerp(230,850,eo(d)),lerp(y1,y2,eo(d)));X.stroke()}));
    if(d>.6){const q=back(seg(t,T.tres+.4,T.tres+.9));X.save();X.translate(600,y2-250);X.scale(q,q);glow(ROJO,60,()=>{rr(-210,-70,420,140,30);X.fillStyle='#2a0612';X.fill()});
      X.strokeStyle=ROJO;X.lineWidth=6;rr(-210,-70,420,140,30);X.stroke();txt('+$300',0,6,96,'#fff',{g:30,gc:ROJO});X.restore()}}
  X.restore()
}


function argentina(t,out){const inn=eo(seg(t,T.s4,T.s4+.7));X.save();X.translate(out*-1100+(1-inn)*1100,0);
  chip(250,640,'ARGENTINA',CIAN,1,1.1);
  // Xbox: precio en pesos en un letrero gigante
  const p=seg(t,T.ar_xbox-.2,T.ar_xbox+.9);haz(540,950,t,'rgb(94,255,161)');
  if(p>0){X.save();X.translate(540,960);X.scale(.92*back(cl(p*1.4)),.92*back(cl(p*1.4)));
    glow(VERDE,80,()=>{rr(-430,-150,860,300,40);X.fillStyle='rgba(8,4,18,.92)';X.fill()});X.strokeStyle=VERDE;X.lineWidth=6;rr(-430,-150,860,300,40);X.stroke();
    txt('XBOX STORE',0,-90,40,VERDE,{g:16});const n=Math.round(eo(p)*113299);txt('$'+n.toLocaleString('es-CL'),0,25,150,AMAR,{g:50});
    txt('pesos argentinos',0,105,34,'rgba(255,255,255,.75)',{w:400});X.restore();chispas(540,960,T.ar_xbox+.7,t)}
  // PS Store: dolares + impuestos
  const q=seg(t,T.ar_ps-.3,T.ar_ps+.4);if(q>0){X.save();X.translate(560,1330);X.rotate(-.05);X.scale(back(q),back(q));
    glow(CIAN,60,()=>{rr(-380,-110,760,220,34);X.fillStyle='rgba(8,4,18,.92)';X.fill()});X.strokeStyle=CIAN;X.lineWidth=5;rr(-380,-110,760,220,34);X.stroke();
    txt('PS STORE',0,-55,36,CIAN,{g:14});txt('US$ + IMPUESTOS',0,30,84,'#fff',{g:30,gc:CIAN});X.restore()}
  X.restore()}
function mismo(t,out){const inn=back(seg(t,T.s5,T.s5+.7));X.save();X.translate(-out*1100,0);
  haz(540,950,t,'rgb(255,45,149)');
  caja(540,1010,Math.sin(t*1.6)*.5,inn*.85,t,null);
  // etiquetas que orbitan y cambian de precio segun la tienda
