const CAR='#c68642',CRM='#f4e6d2',ESP='#1a120b',ROJC='#c8352b',HOJ='#4f7a3a';
function cafeteria(t,cam){
  const g=X.createLinearGradient(0,0,0,H);g.addColorStop(0,'#21150c');g.addColorStop(.7,'#2b1a0e');g.addColorStop(1,'#1a0f07');X.fillStyle=g;X.fillRect(0,0,W,H);
  // luces calidas desenfocadas (cafeteria de noche)
  add(()=>{for(let i=0;i<14;i++){const x=rnd(i+3)*W+Math.sin(t*.2+i)*20+cam.x*.2,y=150+rnd(i+9)*700,r=60+rnd(i+1)*120;const rg=X.createRadialGradient(x,y,0,x,y,r);
    rg.addColorStop(0,`rgba(255,${170+rnd(i)*50|0},90,${.10+.06*Math.sin(t+i)})`);rg.addColorStop(1,'rgba(0,0,0,0)');X.fillStyle=rg;X.fillRect(x-r,y-r,2*r,2*r)}});
  // vapor suave
  add(()=>{X.strokeStyle='rgba(244,230,210,.06)';X.lineWidth=18;X.lineCap='round';for(let i=0;i<4;i++){const x0=200+i*230;X.beginPath();for(let y=1500;y>300;y-=20){const x=x0+Math.sin(y*.012+t*1.3+i)*30;y===1500?X.moveTo(x,y):X.lineTo(x,y)}X.stroke()}});
  // mesa de madera
  const my=1600;X.fillStyle='#3a2414';X.fillRect(0,my,W,H-my);X.fillStyle='#4a2e19';X.fillRect(0,my,W,14);
  X.strokeStyle='rgba(0,0,0,.18)';X.lineWidth=3;for(let i=0;i<6;i++){X.beginPath();X.moveTo(0,my+40+i*50);X.bezierCurveTo(300,my+30+i*50,700,my+60+i*50,W,my+40+i*50);X.stroke()}
  // granos de fondo flotando
  for(let i=0;i<10;i++){const y=(rnd(i+20)*H+t*(14+rnd(i)*20))%(H-400);grano(rnd(i+40)*W,y,18+rnd(i+2)*12,rnd(i)*6+t*.3,.22)}
  const v=X.createRadialGradient(540,960,350,540,960,1250);v.addColorStop(0,'rgba(0,0,0,0)');v.addColorStop(1,'rgba(0,0,0,.55)');X.fillStyle=v;X.fillRect(0,0,W,H);
}
function grano(x,y,r,rot,a=1,plano=false,redondo=false){X.save();X.translate(x,y);X.rotate(rot);X.globalAlpha*=a;
  X.fillStyle='#6b3f1f';X.beginPath();X.ellipse(0,0,r*(redondo?.85:.72),r,0,0,7);X.fill();
  X.fillStyle='rgba(255,220,180,.12)';X.beginPath();X.ellipse(-r*.22,-r*.3,r*.25,r*.4,0,0,7);X.fill();
  if(!redondo){X.strokeStyle='#2a160a';X.lineWidth=Math.max(2,r*.12);X.beginPath();X.moveTo(0,-r*.82);X.bezierCurveTo(r*.25,-r*.3,-r*.25,r*.3,0,r*.82);X.stroke()}
  X.restore()}
function cereza(x,y,r,t,a=1){X.save();X.translate(x,y);X.globalAlpha*=a;
  X.strokeStyle=HOJ;X.lineWidth=r*.12;X.beginPath();X.moveTo(0,-r*.9);X.quadraticCurveTo(r*.3,-r*1.5,r*.1,-r*1.9);X.stroke();
  X.fillStyle=HOJ;X.beginPath();X.ellipse(r*.55,-r*1.55,r*.5,r*.22,-.5,0,7);X.fill();
  X.fillStyle=ROJC;X.beginPath();X.arc(0,0,r,0,7);X.fill();X.fillStyle='rgba(255,255,255,.25)';X.beginPath();X.ellipse(-r*.35,-r*.35,r*.22,r*.14,-.6,0,7);X.fill();X.restore()}
function corte(x,y,r,t,abre,uno=false){X.save();X.translate(x,y);
  X.fillStyle=ROJC;X.beginPath();X.arc(0,0,r,0,7);X.fill();X.fillStyle='#f0d48a';X.beginPath();X.arc(0,0,r*.84,0,7);X.fill();
  if(uno){X.fillStyle='#d8c39a';X.beginPath();X.ellipse(0,0,r*.5,r*.6,0,0,7);X.fill();X.strokeStyle='#8a6a3a';X.lineWidth=4;X.stroke()}
  else{[-1,1].forEach(sg=>{X.fillStyle='#d8c39a';X.beginPath();X.moveTo(sg*r*.04*(1+abre*4),-r*.6);X.quadraticCurveTo(sg*r*.75,-r*.5,sg*r*.7,0);X.quadraticCurveTo(sg*r*.75,r*.5,sg*r*.04*(1+abre*4),r*.6);X.closePath();X.fill();X.strokeStyle='#8a6a3a';X.lineWidth=4;X.stroke()})}
  X.restore()}
function etiqueta(x,y,l,col,p,s=1.2){if(p<=0)return;X.save();X.translate(x,y);X.scale(back(p)*s,back(p)*s);X.font='700 38px P';const hw=X.measureText(l).width/2+34;
  X.fillStyle=ESP;rr(-hw,-38,hw*2,76,38);X.fill();X.strokeStyle=col;X.lineWidth=5;X.stroke();txt(l,0,3,38,col);X.restore()}
