  const dur=(f.b-f.a)*.92;let idx=Math.floor(cl((t-f.a)/dur)*ws.length);if(f.w&&f.w.length===ws.length){idx=-1;f.w.forEach((wt,j)=>{if(t>=wt)idx=j})}
  X.save();X.font='700 54px P';
  const wrap=arr=>{const L=[];let l=[];for(const w of arr){const p=[...l,w].join(' ');if(X.measureText(p).width>860&&l.length){L.push(l);l=[w]}else l.push(w)}L.push(l);return L};
  let lineas=wrap(ws),k0=0;   // subtitulos: maximo 2 lineas; si no cabe, se divide en partes que se muestran una tras otra
  if(lineas.length>2){const n=Math.ceil(lineas.length/2),per=Math.ceil(ws.length/n);for(let i=0;i<n;i++){const s0=i*per,s1=Math.min(ws.length,(i+1)*per);if(idx<s1||i===n-1){k0=s0;lineas=wrap(ws.slice(s0,s1));break}}}
  let k=k0;lineas.forEach((ln,li)=>{const tot=X.measureText(ln.join(' ')).width;let x=540-tot/2;const y=300+li*72;
    ln.forEach(w=>{const dicha=k<=idx,clave=f.k.includes(w)&&dicha;const ap=cl((t-(f.w&&f.w.length===ws.length?f.w[k]:f.a+(k/ws.length)*dur))*8);
