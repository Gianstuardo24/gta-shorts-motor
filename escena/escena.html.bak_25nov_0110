  glow(NAR,30,()=>{X.beginPath();const n=18;for(let i=0;i<n;i++){const a=i/n*Math.PI*2,r=1+.12*Math.sin(i*3.7);X.lineTo(Math.cos(a)*len*r,Math.sin(a)*len*.22*r)}X.closePath();
    const g=X.createLinearGradient(0,-len*.22,0,len*.22);g.addColorStop(0,'#d28a5c');g.addColorStop(1,'#4a2416');X.fillStyle=g;X.fill()});
  X.fillStyle='rgba(30,12,6,.5)';[[-.5,.02,.06],[.1,-.05,.05],[.55,.04,.045],[-.15,.08,.035]].forEach(([a,b,r])=>{X.beginPath();X.arc(a*len,b*len,r*len,0,7);X.fill()});
  X.restore()}
function orbita(cx,cy,r,col,a=.35){X.strokeStyle=col;X.globalAlpha=a;X.lineWidth=2;X.beginPath();X.ellipse(cx,cy,r,r*.42,0,0,7);X.stroke();X.globalAlpha=1}
function sello(x,y,txtS,col,p,rot=-.1,size=80){if(p<=0)return;X.save();X.translate(x,y);X.rotate(rot);const k=lerp(2.2,1,eo(cl(p)));X.scale(k,k);X.globalAlpha=cl(p*2);
  X.font=`700 ${size}px P`;const w=X.measureText(txtS).width+80;X.strokeStyle=col;X.lineWidth=9;rr(-w/2,-size*.85,w,size*1.7,16);X.stroke();txt(txtS,0,6,size,col,{g:30,gc:col});X.restore()}
