{"frases": [{"a": 0, "b": 2.031, "t": "A newspaper invented flying saucers.", "k": ["newspaper"], "w": [0.056, 0.172, 0.708, 1.192, 1.571]}, {"a": 2.031, "b": 3.966, "t": "Not a pilot, not a witness.", "k": ["witness."], "w": [2.081, 2.302, 2.418, 2.823, 3.044, 3.16]}, {"a": 3.966, "b": 9.405999999999999, "t": "In June 1947, pilot Kenneth Arnold saw nine shiny objects near Mount Rainier.", "k": ["1947,"], "w": [4.016, 4.201, 4.501, 5.357, 5.715, 6.189, 6.605, 6.848, 7.148, 7.507, 7.981, 8.281, 8.639]}, {"a": 9.405999999999999, "b": 12.475999999999999, "t": "He compared the way they moved to a saucer skipping across water.", "k": ["compared"], "w": [9.456, 9.587, 9.962, 10.134, 10.306, 10.518, 10.771, 10.902, 10.992, 11.286, 11.661, 11.956]}, {"a": 12.475999999999999, "b": 16.016, "t": "But the papers ran it as flying saucers, and the name stuck.", "k": ["saucers,"], "w": [12.526, 12.734, 12.943, 13.3, 13.508, 13.667, 13.825, 14.183, 14.664, 14.872, 15.08, 15.338]}, {"a": 16.016, "b": 18.066, "t": "Now watch what one headline did.", "k": ["headline"], "w": [16.066, 16.272, 16.577, 16.832, 17.038, 17.49]}, {"a": 18.066, "b": 22.326, "t": "Within weeks, hundreds of people across the country reported flying saucers.", "k": ["country"], "w": [18.116, 18.475, 18.86, 19.319, 19.479, 19.838, 20.198, 20.408, 20.817, 21.276, 21.636]}, {"a": 22.326, "b": 25.151, "t": "And Arnold later drew his objects thin and crescent shaped.", "k": ["crescent"], "w": [22.376, 22.566, 22.891, 23.172, 23.407, 23.596, 23.967, 24.202, 24.392, 24.808]}, {"a": 25.151, "b": 27.535999999999998, "t": "So the classic saucer started as a headline.", "k": ["headline."], "w": [25.201, 25.346, 25.536, 25.906, 26.232, 26.602, 26.747, 26.846]}, {"a": 27.535999999999998, "b": 29.886, "t": "Tell me if you knew where the name came from.", "k": ["where"], "w": [27.586, 27.801, 27.933, 28.065, 28.239, 28.454, 28.71, 28.883, 29.098, 29.313]}, {"a": 29.886, "b": 32.89, "t": "Follow for the next case.", "k": ["Follow"], "w": [29.936, 30.251, 30.435, 30.619, 30.847]}], "T": {"s_1": 4.016, "s_2": 9.456, "s_3": 12.526, "s_4": 16.066, "s_5": 18.116, "s_6": 22.376, "s_fin": 27.586, "s_cta": 29.936, "witness": 3.16, "nine": 6.848, "skipping": 11.286, "stuck": 15.338, "headline": 17.038, "hundreds": 18.86, "crescent": 24.392, "fin": 32.94}, "marca": "THE RABBIT LOOP", "cierre": "DID YOU KNOW?", "cierre2": "Yes or no? Comment", "paises": ["YES", "NO"], "cta": "FOLLOW FOR MORE", "like": "LIKE", "escenas": [{"tipo": "pelicula", "desde": "0", "escala": 1.24, "zonas": [{"x0": -300, "x1": 1300, "set": "montanaV", "o": {"objetos": 1, "avion": 1}, "cam": 0}, {"x0": 1300, "x1": 2600, "set": "noticiasV", "o": {"cintillo": "FLYING SAUCERS SIGHTED"}, "k": "s_3", "cam": 1300}, {"x0": 2600, "x1": 3900, "set": "nocheV", "o": {"ciudad": true, "sem": 33}, "k": "s_5", "cam": 2600}, {"x0": 102480, "x1": 103800, "set": "vitrinaV", "cam": 102600, "o": {"fondo": ["#1d1a14", "#0e0c08", "#020201"], "luz2": "255,236,190"}}, {"x0": 105080, "x1": 106400, "set": "vitrinaV", "cam": 105200, "o": {"fondo": ["#2f6aa8", "#173a63", "#06121f"], "luz2": "200,230,255"}}, {"x0": 107680, "x1": 109000, "set": "vitrinaV", "cam": 107800, "o": {"fondo": ["#1d1a14", "#0e0c08", "#020201"], "luz2": "255,236,190"}}, {"x0": 110280, "x1": 111600, "set": "vitrinaV", "cam": 110400, "o": {"fondo": ["#e8e2d2", "#a89878", "#2a2214"], "luz2": "255,245,220"}}], "pan": [{"k": "s_3", "x": 1300, "dur": 0.04, "corte": 1, "dir": 1}, {"k": "s_5", "x": 2600, "dur": 0.04, "corte": 1, "dir": 1}, {"k": 0.01, "x": 102600, "dur": 0.04, "corte": 1}, {"k": "s_1", "x": 0, "dur": 0.04, "corte": 1, "dir": 1}, {"k": "s_2", "x": 105200, "dur": 0.04, "corte": 1}, {"k": "s_3", "x": 1300, "dur": 0.04, "corte": 1, "dir": 1}, {"k": "s_4", "x": 107800, "dur": 0.04, "corte": 1}, {"k": "s_5", "x": 2600, "dur": 0.04, "corte": 1, "dir": 1}, {"k": "s_6", "x": 110400, "dur": 0.04, "corte": 1}, {"k": "s_fin", "x": 2600, "dur": 0.04, "corte": 1, "dir": 1}], "props": [{"