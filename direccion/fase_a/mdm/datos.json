{"frases": [{"a": 0, "b": 2.108, "t": "Some call it Nike's dirtiest deal.", "k": ["dirtiest"], "w": [0.056, 0.362, 0.668, 0.857, 1.222, 1.763]}, {"a": 2.108, "b": 4.845, "t": "The price was so low it sounds like a joke.", "k": ["price"], "w": [2.158, 2.405, 2.77, 3.017, 3.205, 3.453, 3.641, 4.065, 4.371, 4.501]}, {"a": 4.845, "b": 7.1160000000000005, "t": "But that's only half the story.", "k": ["that's"], "w": [4.895, 5.142, 5.507, 5.813, 6.119, 6.367]}, {"a": 7.1160000000000005, "b": 11.315999999999999, "t": "In 1971, Phil Knight needed a logo for his new shoe brand.", "k": ["1971,"], "w": [7.166, 7.345, 8.173, 8.464, 8.867, 9.269, 9.393, 9.683, 9.918, 10.153, 10.388, 10.679]}, {"a": 11.315999999999999, "b": 14.245999999999999, "t": "He asked a design student, Carolyn Davidson.", "k": ["Davidson."], "w": [11.366, 11.547, 11.896, 12.02, 12.427, 12.974, 13.436]}, {"a": 14.245999999999999, "b": 16.226, "t": "She charged 2 dollars an hour.", "k": ["2", "dollars"], "w": [14.296, 14.529, 14.984, 15.272, 15.727, 15.904]}, {"a": 16.226, "b": 20.285999999999998, "t": "After about 17 hours of work, the bill was 35 dollars.", "k": ["17", "35", "dollars."], "w": [16.276, 16.62, 16.963, 17.429, 17.773, 17.951, 18.322, 18.555, 18.843, 19.076, 19.542]}, {"a": 20.285999999999998, "b": 22.04, "t": "Knight wasn't even sure about it.", "k": ["Knight"], "w": [20.336, 20.7, 21.013, 21.276, 21.539, 21.852]}, {"a": 22.04, "b": 25.096, "t": "He said he didn't love it, but it would grow on him.", "k": ["didn't"], "w": [22.09, 22.252, 22.514, 22.676, 22.99, 23.252, 23.49, 23.702, 23.864, 24.177, 24.44, 24.602]}, {"a": 25.096, "b": 29.256, "t": "That logo became the swoosh, one of the most famous logos on Earth.", "k": ["swoosh,"], "w": [25.146, 25.423, 25.7, 26.084, 26.307, 26.771, 26.994, 27.165, 27.389, 27.666, 28.049, 28.379, 28.55]}, {"a": 29.256, "b": 32.936, "t": "Now the other half of the story, the one that everyone misses.", "k": ["everyone"], "w": [29.306, 29.517, 29.728, 30.039, 30.3, 30.461, 30.672, 31.058, 31.269, 31.48, 31.741, 32.203]}, {"a": 32.936, "b": 37.436, "t": "In 1983, Nike surprised her with a gold swoosh ring with a diamond.", "k": ["1983,"], "w": [32.986, 33.156, 33.944, 34.221, 34.765, 34.988, 35.265, 35.382, 35.659, 36.043, 36.319, 36.596, 36.713]}, {"a": 37.436, "b": 39.896, "t": "And 500 shares of Nike stock.", "k": ["500"], "w": [37.486, 37.723, 38.377, 38.782, 38.963, 39.256]}, {"a": 39.896, "b": 41.371, "t": "So it wasn't a dirty deal.", "k": ["wasn't"], "w": [39.946, 40.116, 40.287, 40.617, 40.734, 41.064]}, {"a": 41.371, "b": 44.726000000000006, "t": "She set her price, and Nike paid her back years later.", "k": ["price,", "paid", "years"], "w": [41.421, 41.645, 41.868, 42.092, 42.502, 42.726, 43.002, 43.279, 43.503, 43.78, 44.11]}, {"a": 44.726000000000006, "b": 46.669000000000004, "t": "Price the work, not the hours.", "k": ["Price"], "w": [44.776, 45.139, 45.385, 45.777, 46.022, 46.268]}, {"a": 46.669000000000004, "b": 49.736000000000004, "t": "A small job can become the face of a giant.", "k": ["become"], "w": [46.719, 46.848, 47.21, 47.456, 47.702, 48.123, 48.369, 48.673, 48.861, 48.989]}, {"a": 49.736000000000004, "b": 51.541000000000004, "t": "Tell me what you would have charged.", "k": ["charged."], "w": [49.786, 50.027, 50.176, 50.417, 50.612, 50.899, 51.141]}, {"a": 51.541000000000004, "b": 55.27, "t": "Follow for the next million dollar mistake.", "k": ["mistake."], "w": [51.591, 51.925, 52.119, 52.314, 52.556, 52.936, 53.27]}], "T": {"fin": 55.32, "s_fin": 55.32, "c1": 7.046, "x_needed": 8.867, "x_logo": 9.393, "x_logo_fin": 9.683, "x_asked": 11.366, "c2": 12.0, "x_carolyn": 12.974, "c3": 14.266, "x_2": 14.984, "x_hour_fin": 16.196, "x_17": 16.963, "x_work_fin": 18.272, "x_35": 19.076, "x_35_fin": 19.842000000000002, "x_rasga": 19.922, "c4": 20.316, "x_love0": 22.676, "x_love1": 23.401999999999997, "x_grow": 23.864, "x_on": 24.44, "c5": 25.146}, "marca": "MILLION DOLLAR MISTAKE", "tema": "mdm", "escenas