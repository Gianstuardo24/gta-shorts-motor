{"frases": [{"a": 0, "b": 3.709, "t": "If coffee sends you running to the bathroom, it's not just the caffeine.", "k": ["bathroom,"], "w": [0.056, 0.213, 0.565, 0.869, 1.075, 1.476, 1.633, 1.839, 2.363, 2.569, 2.774, 3.029, 3.235]}, {"a": 3.709, "b": 6.156000000000001, "t": "And there's a detail almost nobody knows.", "k": ["there's"], "w": [3.759, 3.965, 4.317, 4.425, 4.778, 5.13, 5.483]}, {"a": 6.156000000000001, "b": 9.415999999999999, "t": "It usually hits in the morning, right after that first cup.", "k": ["morning,"], "w": [6.206, 6.358, 6.748, 6.995, 7.147, 7.347, 7.808, 8.103, 8.397, 8.644, 8.939]}, {"a": 9.415999999999999, "b": 12.405999999999999, "t": "In 1990, researchers in the UK tested it.", "k": ["1990,"], "w": [9.466, 9.632, 10.4, 11.033, 11.199, 11.417, 11.583, 11.956]}, {"a": 12.405999999999999, "b": 15.056, "t": "They placed pressure sensors in volunteers' lower gut,", "k": ["volunteers'"], "w": [12.456, 12.702, 13.042, 13.476, 13.864, 14.015, 14.544, 14.837]}, {"a": 15.056, "b": 16.866, "t": "and gave them a cup of coffee.", "k": ["coffee."], "w": [15.106, 15.304, 15.55, 15.796, 15.9, 16.098, 16.249]}, {"a": 16.866, "b": 20.503999999999998, "t": "In people who felt the urge, the gut started moving within four minutes.", "k": ["minutes."], "w": [16.916, 17.068, 17.41, 17.609, 17.856, 18.056, 18.374, 18.574, 18.773, 19.162, 19.504, 19.846, 20.093]}, {"a": 20.503999999999998, "b": 23.016, "t": "And it kept going for at least half an hour.", "k": ["going"], "w": [20.554, 20.754, 20.905, 21.152, 21.447, 21.646, 21.798, 22.093, 22.34, 22.492]}, {"a": 23.016, "b": 26.041999999999998, "t": "They also tested it with plain hot water and no coffee,", "k": ["coffee,"], "w": [23.066, 23.334, 23.602, 23.973, 24.138, 24.406, 24.726, 24.943, 25.262, 25.479, 25.644]}, {"a": 26.041999999999998, "b": 27.13, "t": "to compare results.", "k": ["results."], "w": [26.092, 26.257, 26.68]}, {"a": 27.13, "b": 28.862, "t": "Surprisingly, nothing happened.", "k": ["Surprisingly,"], "w": [27.18, 27.938, 28.361]}, {"a": 28.862, "b": 30.956, "t": "So it wasn't about a warm drink.", "k": ["wasn't"], "w": [28.912, 29.077, 29.242, 29.562, 29.882, 29.995, 30.263]}, {"a": 30.956, "b": 33.277, "t": "But here's the detail almost nobody knows,", "k": ["here's"], "w": [31.006, 31.228, 31.556, 31.778, 32.158, 32.539, 32.92]}, {"a": 33.277, "b": 35.626000000000005, "t": "and it changes who this happens to.", "k": ["changes"], "w": [33.327, 33.549, 33.718, 34.151, 34.373, 34.648, 35.082]}, {"a": 35.626000000000005, "b": 36.616, "t": "Decaf did it too.", "k": ["Decaf"], "w": [35.676, 35.994, 36.21, 36.374]}, {"a": 36.616, "b": 39.736000000000004, "t": "Less than regular coffee, but still more than water.", "k": ["regular"], "w": [36.666, 36.933, 37.2, 37.621, 38.067, 38.283, 38.601, 38.868, 39.135]}, {"a": 39.736000000000004, "b": 44.126000000000005, "t": "That's because coffee triggers a gut hormone called gastrin, even without caffeine.", "k": ["caffeine."], "w": [39.786, 40.083, 40.475, 40.82, 41.26, 41.365, 41.566, 41.958, 42.303, 42.767, 43.016, 43.408]}, {"a": 44.126000000000005, "b": 46.099000000000004, "t": "Gastrin tells your gut to get moving.", "k": ["Gastrin"], "w": [44.176, 44.581, 44.888, 45.145, 45.353, 45.511, 45.719]}, {"a": 46.099000000000004, "b": 49.416000000000004, "t": "It's the same kind of signal your body sends after you eat.", "k": ["signal"], "w": [46.149, 46.357, 46.564, 46.822, 47.079, 47.237, 47.593, 47.85, 48.107, 48.414, 48.72, 48.928]}, {"a": 49.416000000000004, "b": 51.156000000000006, "t": "And it doesn't happen to everyone.", "k": ["everyone."], "w": [49.466, 49.671, 49.827, 50.178, 50.528, 50.684]}, {"a": 51.156000000000006, "b": 53.364000000000004, "t": "Only about 3 in 10 people feel it,", "k": ["3", "10"], "w": [51.206, 51.459, 51.762, 52.015, 52.171, 52.58, 52.931, 53.185]}, {"a": 53.364000000000004, "b": 55.116, "t": "and women far more than men.", "k": ["women"], "w": [53.414, 53.618, 53.921, 54.125, 54.379, 54.632]}, {"a": 55.116, "b": 57.936, "t": "So if it happens to you, it's your gut waking up.", "k": ["happens"], "w": [55.166, 55.318, 55.469, 55.621, 56.01, 56.161, 56.431, 56.63, 56.877, 57.076, 57.417]}, {"a": 57.936, "b": 59.78, "t": "Tell me if coffee does this to you.", "k": ["coffee"], "w": [57.986, 58.238, 58.393, 58.547, 58.896, 59.148, 59.399, 59.554]}, {"a": 59.78, "b": 63.36, "t": "Follow for one coffee curiosity a day.", "k": ["curiosity"], "w": [59.83, 60.179, 60.382, 60.585, 60.934, 61.428, 61.534]}], "T": {"fin": 63.41, "s_fin": 63.41, "x_running": 1.075, "x_its": 2.363, "x_and1": 3.759, "x_right2": 7.808, "x_first": 8.644, "x_res": 10.4, "x_tested": 11.583, "x_sensors": 13.476, "x_gave": 15.304, "x_moving": 19.162, "x_four": 19.846, "x_and5": 20.554, "x_half": 22.093, "x_nothing": 27.938, "x_so6": 28.912, "x_decaf": 35.676, "x_less": 36.666, "x_water8": 39.135, "x_gastrin": 42.303, "x_even": 42.767, "x_gastrin2": 44.176, "x_same": 46.564, "x_eat": 48.928, "x_three": 51.762, "x_women": 53.618, "x_gut12": 56.877, "x_tell": 57.866, "s_cta": 59.83, "c02": 6.086, "c03a": 9.346, "c03b": 12.336, "c04": 16.796, "c05a": 22.945999999999998, "c05b": 24.366, "c06": 30.886, "c07": 39.666000000000004, "c08": 49.346000000000004, "c09": 55.046}, "marca": "COFFEE, BUT WHY?", "tema": "cafe", "escenas": [{"tipo": "pelicula", "desde": "0", "luz": false, "p27_fija": true, "escala": 1.24, "zoom": [{"k": -1, "s": 1.0, "dur": 0.01, "y": 1200}], "zonas": [{"x0": 100000, "x1": 101300, "cam": 100000, "set": "dc_coffee17_p01", "entorno": "dc_coffee17_p01", "transicion": "inicio", "camara": "fija", "acabado": "ninguno", "razon": "gancho: toma café y se levanta rápido"}, {"x0": 102600, "x1": 103900, "cam": 102600, "set": "dc_coffee17_p02", "entorno": "dc_coffee17_p02", "transicion": "corte", "camara": "fija", "acabado": "ninguno", "razon": "la silla da paso a la mañana: detalle de taza y paneo al pasillo", "k": "c02"}, {"x0": 105200, "x1": 106500, "cam": 105200, "set": "dc_coffe