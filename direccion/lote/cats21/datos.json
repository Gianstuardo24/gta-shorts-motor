{"frases": [{"a": 0, "b": 1.515, "t": "Your cat secretly speaks to you.", "k": ["secretly"], "w": [0.056, 0.282, 0.465, 0.865, 1.178, 1.317]}, {"a": 1.515, "b": 3.4320000000000004, "t": "And it might explain more than you think.", "k": ["explain"], "w": [1.565, 1.747, 1.887, 2.156, 2.513, 2.739, 2.965, 3.148]}, {"a": 3.4320000000000004, "b": 6.196000000000001, "t": "Careful, there might be other details you're missing.", "k": ["missing."], "w": [3.482, 3.904, 4.174, 4.443, 4.582, 4.852, 5.209, 5.478]}, {"a": 6.196000000000001, "b": 8.026, "t": "Kittens meow to call their mother.", "k": ["Kittens"], "w": [6.246, 6.598, 6.821, 6.958, 7.181, 7.447]}, {"a": 8.026, "b": 10.065, "t": "But adult cats rarely meow at each other.", "k": ["rarely"], "w": [8.076, 8.27, 8.557, 8.797, 9.13, 9.371, 9.519, 9.759]}, {"a": 10.065, "b": 12.776, "t": "They use scent, body language, hisses and growls.", "k": ["language,"], "w": [10.115, 10.355, 10.55, 10.906, 11.146, 11.641, 11.974, 12.168]}, {"a": 12.776, "b": 15.196, "t": "Cats living without people are mostly quiet.", "k": ["without"], "w": [12.826, 13.066, 13.398, 13.776, 14.109, 14.303, 14.635]}, {"a": 15.196, "b": 17.636, "t": "The meow is something they mostly save for us.", "k": ["something"], "w": [15.246, 15.424, 15.645, 15.781, 16.214, 16.435, 16.741, 16.962, 17.14]}, {"a": 17.636, "b": 19.566, "t": "Now the detail you might be missing.", "k": ["missing."], "w": [17.686, 17.857, 18.028, 18.321, 18.492, 18.745, 18.875]}, {"a": 19.566, "b": 21.458, "t": "Your cat learns which meows work on you:", "k": ["learns"], "w": [19.616, 19.844, 20.029, 20.345, 20.617, 20.889, 21.117, 21.258]}, {"a": 21.458, "b": 24.105999999999998, "t": "one for food, one for the door, one for attention.", "k": ["attention."], "w": [21.508, 21.692, 21.877, 22.171, 22.355, 22.539, 22.724, 23.018, 23.202, 23.386]}, {"a": 24.105999999999998, "b": 26.566, "t": "Meowing at people is partly something they learn.", "k": ["something"], "w": [24.156, 24.503, 24.638, 24.943, 25.078, 25.383, 25.814, 26.034]}, {"a": 26.566, "b": 28.826, "t": "That's why the early morning meow works so well.", "k": ["morning"], "w": [26.616, 26.895, 27.083, 27.272, 27.55, 27.919, 28.152, 28.431, 28.575]}, {"a": 28.826, "b": 30.506, "t": "It learned that one from you.", "k": ["learned"], "w": [28.876, 29.02, 29.388, 29.622, 29.81, 30.044]}, {"a": 30.506, "b": 33.637, "t": "So when your cat meows at you, it's talking to you on purpose.", "k": ["purpose."], "w": [30.556, 30.709, 30.957, 31.205, 31.405, 31.701, 31.854, 32.126, 32.327, 32.718, 32.871, 33.071, 33.224]}, {"a": 33.637, "b": 34.646, "t": "Answer back.", "k": ["Answer"], "w": [33.687, 34.03]}, {"a": 34.646, "b": 36.861000000000004, "t": "Tell me what your cat's meow usually means.", "k": ["usually"], "w": [34.696, 34.951, 35.108, 35.364, 35.619, 35.874, 36.13, 36.532]}, {"a": 36.861000000000004, "b": 39.86, "t": "Follow to decode your cat.", "k": ["Follow"], "w": [36.911, 37.264, 37.421, 37.775, 38.03]}], "T": {"fin": 39.91, "s_fin": 39.91, "x_speaks": 0.865, "x_explain": 2.156, "x_careful": 3.482, "x_youre": 5.209, "x_meow2": 6.598, "x_mother": 7.447, "x_scent": 10.55, "x_body": 10.906, "x_hisses": 11.641, "x_meow5": 15.424, "x_save": 16.741, "x_meows7": 20.617, "x_food": 21.877, "x_one2": 22.171, "x_door": 22.724, "x_one3": 23.018, "x_att": 23.386, "x_learn": 26.034, "x_meow9": 27.919, "x_well": 28.575, "x_learned": 29.02, "x_meows10": 31.405, "x_talking": 32.327, "x_answer": 33.687, "x_tell": 34.576, "s_cta": 36.911, "c02": 6.126, "c03": 7.956, "c04a": 12.706000000000001, "c04b": 13.358, "c04c": 15.126000000000001, "c05": 17.566, "c06": 24.035999999999998, "c07": 26.496, "c08": 30.436}, "marca": "THE CATS DECODER", "tema": "mascotas", "escenas": [{"tipo": "pelicula", "desde": "0", "luz": false, "p27_fija": true, "escala": 1.24, "zoom": [{"k": -1, "s": 1.0, "dur": 0.01, "y": 1200}], "zonas": [{"x0": 100000, "x1": 101300, "cam": 100000, "set": "dc_cats21_p01", "entorno": "dc_cats21_p01"