{"frases": [{"a": 0, "b": 1.496, "t": "GTA 5 humilló a GTA 6.", "k": ["5", "6."], "w": [0.056, 0.27, 0.536, 0.954, 1.066, 1.281]}, {"a": 1.496, "b": 2.9200000000000004, "t": "Y no es por lo que crees.", "k": ["crees."], "w": [1.546, 1.658, 1.821, 1.985, 2.199, 2.362, 2.577]}, {"a": 2.9200000000000004, "b": 3.415, "t": "Cuidado,", "k": ["Cuidado,"], "w": [2.97]}, {"a": 3.415, "b": 7.516, "t": "el detalle que viene después podría cambiar lo que piensas de GTA 6.", "k": ["6."], "w": [3.465, 3.628, 4.046, 4.261, 4.577, 4.995, 5.363, 5.781, 5.944, 6.159, 6.577, 6.74, 6.955]}, {"a": 7.516, "b": 12.356, "t": "GTA 5 vendió más de 215 millones de copias desde 2013, según Take-Two.", "k": ["5", "215", "2013,"], "w": [7.566, 7.775, 8.034, 8.392, 8.601, 8.761, 9.338, 9.796, 9.955, 10.313, 10.622, 11.359, 11.667]}, {"a": 12.356, "b": 15.616, "t": "Eso lo convierte en uno de los juegos más vendidos de la historia.", "k": ["convierte"], "w": [12.406, 12.586, 12.723, 13.16, 13.297, 13.477, 13.614, 13.794, 14.103, 14.283, 14.677, 14.814, 14.951]}, {"a": 15.616, "b": 20.086, "t": "Y GTA 6 partió fuerte: 32,5 millones vendidos antes de salir.", "k": ["6", "32,5"], "w": [15.666, 15.79, 16.028, 16.321, 16.728, 17.219, 17.875, 18.394, 18.914, 19.264, 19.445]}, {"a": 20.086, "b": 21.009, "t": "Suena enorme.", "k": ["enorme."], "w": [20.136, 20.52]}, {"a": 21.009, "b": 21.980999999999998, "t": "Y lo es.", "k": ["es."], "w": [21.059, 21.196, 21.394]}, {"a": 21.980999999999998, "b": 24.241, "t": "Pero hay un cálculo que casi nadie hace.", "k": ["cálculo"], "w": [22.031, 22.262, 22.448, 22.591, 22.955, 23.141, 23.372, 23.647]}, {"a": 24.241, "b": 26.993, "t": "Esos 32,5 millones son apenas el 15", "k": ["32,5", "15"], "w": [24.291, 24.583, 25.235, 25.751, 25.987, 26.392, 26.571]}, {"a": 26.993, "b": 29.361, "t": "por ciento de lo que lleva GTA 5.", "k": ["5."], "w": [27.043, 27.279, 27.683, 27.863, 28.043, 28.279, 28.627, 28.863]}, {"a": 29.361, "b": 30.191, "t": "Para alcanzarlo,", "k": ["alcanzarlo,"], "w": [29.411, 29.652]}, {"a": 30.191, "b": 33.501000000000005, "t": "GTA 6 tendría que vender casi siete veces lo que ya vendió.", "k": ["6"], "w": [30.241, 30.435, 30.676, 31.056, 31.251, 31.585, 31.826, 32.113, 32.4, 32.549, 32.743, 32.892]}, {"a": 33.501000000000005, "b": 36.181000000000004, "t": "Pero a GTA 5 le tomó 13 años llegar ahí.", "k": ["5", "13"], "w": [33.551, 33.821, 33.935, 34.152, 34.422, 34.588, 34.858, 35.293, 35.563, 35.936]}, {"a": 36.181000000000004, "b": 37.891000000000005, "t": "GTA 6 recién empieza.", "k": ["6"], "w": [36.231, 36.449, 36.719, 37.092]}, {"a": 37.891000000000005, "b": 39.569, "t": "Comenta si crees que GTA 6 lo", "k": ["6"], "w": [37.941, 38.341, 38.497, 38.799, 39.004, 39.209, 39.463]}, {"a": 39.569, "b": 41.271, "t": "va a superar y en cuánto tiempo.", "k": ["superar"], "w": [39.619, 39.775, 39.882, 40.282, 40.39, 40.546, 40.897]}, {"a": 41.271, "b": 45.11, "t": "Sigue el canal para más números de GTA 6.", "k": ["6."], "w": [41.321, 41.624, 41.78, 42.082, 42.336, 42.54, 42.94, 43.097, 43.301]}], "T": {"fin": 45.16, "s_fin": 45.16, "x_hum": 0.536, "x_yno": 1.546, "x_cui": 2.97, "x_215": 8.761, "x_mill": 9.338, "x_desde": 10.313, "x_2013": 10.622, "s_3": 12.286000000000001, "x_partio": 16.321, "x_325": 17.219, "x_antes": 18.914, "s_5": 20.016, "s_7": 24.171, "x_325b": 24.583, "x_15": 26.571, "x_lleva": 28.279, "x_siete": 31.826, "x_13": 34.858, "x_recien": 36.719, "x_tell": 37.821000000000005, "s_cta": 41.321, "c02": 7.446, "c03": 15.546000000000001, "c04": 21.910999999999998, "c05": 29.291, "c06a": 33.431000000000004, "c06b": 36.131, "c07": 37.821000000000005}, "marca": "VICEVERSO GG", "tema": null, "escenas": [{"tipo": "pelicula", "desde": "0", "luz": false, "p27_fija": true, "escala": 1.24, "zoom": [{"k": -1, "s": 1.0, "dur": 0.01, "y": 1200}], "zonas": [{"x0": 100000, "x1": 101300, "cam": 100000, "set": "dc_gtaes19_p01", "entorno": "dc_gtaes19_p01", "transicion": "inicio", "camara": "fija", "acabado": "ninguno