{"frases": [{"a": 0, "b": 1.613, "t": "Don't trust your dog's tail wag.", "k": ["Don't"], "w": [0.056, 0.312, 0.616, 0.872, 1.127, 1.383]}, {"a": 1.613, "b": 5.033, "t": "Most people read it as happy, and they might be reading it wrong.", "k": ["reading"], "w": [1.663, 1.919, 2.272, 2.528, 2.685, 2.842, 3.221, 3.427, 3.683, 3.988, 4.145, 4.548, 4.705]}, {"a": 5.033, "b": 7.586, "t": "But there's a detail almost nobody notices.", "k": ["notices."], "w": [5.083, 5.29, 5.644, 5.752, 6.106, 6.459, 6.813]}, {"a": 7.586, "b": 12.436, "t": "In 2007, researchers in Italy filmed dogs while they looked at different things.", "k": ["2007,"], "w": [7.636, 7.795, 8.528, 9.133, 9.291, 9.598, 9.955, 10.213, 10.52, 10.778, 11.135, 11.293, 11.799]}, {"a": 12.436, "b": 13.298, "t": "Their owner.", "k": ["owner."], "w": [12.486, 12.871]}, {"a": 13.298, "b": 14.098999999999998, "t": "A stranger.", "k": ["stranger."], "w": [13.348, 13.485]}, {"a": 14.098999999999998, "b": 14.588999999999999, "t": "A cat.", "k": ["cat."], "w": [14.149, 14.285]}, {"a": 14.588999999999999, "b": 17.016, "t": "And an unfamiliar, dominant dog.", "k": ["unfamiliar,"], "w": [14.639, 14.899, 15.098, 15.886, 16.456]}, {"a": 17.016, "b": 18.000999999999998, "t": "Every dog wagged.", "k": ["wagged."], "w": [17.066, 17.386, 17.602]}, {"a": 18.000999999999998, "b": 20.046, "t": "But the tail didn't swing evenly.", "k": ["evenly."], "w": [18.051, 18.267, 18.484, 18.752, 19.072, 19.391]}, {"a": 20.046, "b": 22.936, "t": "With their owner, the wag leaned to the dog's right side.", "k": ["owner,"], "w": [20.096, 20.324, 20.595, 20.932, 21.115, 21.299, 21.614, 21.754, 21.938, 22.166, 22.437]}, {"a": 22.936, "b": 25.346, "t": "With the dominant dog, it leaned to the left.", "k": ["dominant"], "w": [22.986, 23.206, 23.384, 23.773, 24.014, 24.149, 24.454, 24.589, 24.767]}, {"a": 25.346, "b": 27.434, "t": "Now the detail almost nobody notices,", "k": ["notices,"], "w": [25.396, 25.617, 25.838, 26.216, 26.595, 26.974]}, {"a": 27.434, "b": 29.836, "t": "the one other dogs read in a second.", "k": ["second."], "w": [27.484, 27.705, 27.926, 28.252, 28.525, 28.798, 28.967, 29.082]}, {"a": 29.836, "b": 34.136, "t": "In 2013, the same team showed dogs videos of another dog wagging.", "k": ["2013,"], "w": [29.886, 30.053, 30.825, 31.044, 31.316, 31.587, 31.963, 32.234, 32.61, 32.777, 33.205, 33.424]}, {"a": 34.136, "b": 36.356, "t": "When the wag leaned right, they stayed relaxed.", "k": ["relaxed."], "w": [34.186, 34.388, 34.551, 34.714, 34.993, 35.292, 35.494, 35.774]}, {"a": 36.356, "b": 39.356, "t": "When it leaned left, their heart rate went up and they looked anxious.", "k": ["anxious."], "w": [36.406, 36.597, 36.715, 36.98, 37.226, 37.454, 37.682, 37.874, 38.065, 38.183, 38.337, 38.528, 38.793]}, {"a": 39.356, "b": 41.161, "t": "That's because each side of the brain", "k": ["because"], "w": [39.406, 39.697, 40.083, 40.327, 40.572, 40.722, 40.919]}, {"a": 41.161, "b": 42.989000000000004, "t": "moves the opposite side of the tail.", "k": ["opposite"], "w": [41.211, 41.502, 41.7, 42.132, 42.376, 42.527, 42.724]}, {"a": 42.989000000000004, "b": 44.808, "t": "One side handles things to approach.", "k": ["approach."], "w": [43.039, 43.237, 43.481, 43.866, 44.205, 44.355]}, {"a": 44.808, "b": 46.916000000000004, "t": "The other, things to back away from.", "k": ["other,"], "w": [44.858, 45.056, 45.417, 45.756, 45.906, 46.151, 46.395]}, {"a": 46.916000000000004, "b": 48.771, "t": "So a wag isn't always a happy wag.", "k": ["always"], "w": [46.966, 47.13, 47.243, 47.459, 47.727, 48.097, 48.21, 48.528]}, {"a": 48.771, "b": 50.746, "t": "Watch which side it leans to.", "k": ["Watch"], "w": [48.821, 49.14, 49.458, 49.725, 49.89, 50.208]}, {"a": 50.746, "b": 53.487, "t": "Tell me which way your dog's tail leans when you get home.", "k": ["which"], "w": [50.796, 51.03, 51.174, 51.453, 51.642, 51.876, 52.11, 52.344, 52.623, 52.858, 53.047, 53.236]}, {"a": 53.487, "b": 56.370000000000005, "t": "Follow t