{"frases": [{"a": 0, "b": 1.744, "t": "Stop buying red toys for your dog.", "k": ["buying"], "w": [0.056, 0.301, 0.64, 0.838, 1.083, 1.28, 1.525]}, {"a": 1.744, "b": 3.1900000000000004, "t": "At least until you see this.", "k": ["least"], "w": [1.794, 1.944, 2.236, 2.528, 2.726, 2.924]}, {"a": 3.1900000000000004, "b": 6.606, "t": "Careful, you might be wasting your money on the wrong colors.", "k": ["Careful,"], "w": [3.24, 3.696, 3.894, 4.186, 4.337, 4.723, 4.968, 5.26, 5.411, 5.608, 5.9]}, {"a": 6.606, "b": 9.725999999999999, "t": "For years, people thought dogs saw the world in black and white.", "k": ["years,"], "w": [6.656, 6.832, 7.154, 7.456, 7.799, 8.017, 8.193, 8.369, 8.628, 8.762, 9.022, 9.198]}, {"a": 9.725999999999999, "b": 13.479, "t": "In 1989, scientist Jay Neitz showed that dogs do see color,", "k": ["1989,"], "w": [9.776, 9.944, 10.723, 11.26, 11.481, 11.808, 12.187, 12.46, 12.734, 12.903, 13.124]}, {"a": 13.479, "b": 14.856, "t": "just fewer than us.", "k": ["fewer"], "w": [13.529, 13.803, 14.129, 14.403]}, {"a": 14.856, "b": 17.215, "t": "We have three types of color cells in our eyes.", "k": ["three"], "w": [14.906, 15.055, 15.298, 15.588, 15.878, 16.027, 16.317, 16.606, 16.756, 16.952]}, {"a": 17.215, "b": 18.465999999999998, "t": "Dogs have only two.", "k": ["Dogs"], "w": [17.265, 17.508, 17.751, 17.994]}, {"a": 18.465999999999998, "b": 20.278, "t": "Specifically, blues and yellows.", "k": ["Specifically,"], "w": [18.516, 19.281, 19.604, 19.823]}, {"a": 20.278, "b": 23.686, "t": "Reds look dark and muddy instead, almost brownish gray.", "k": ["instead,"], "w": [20.328, 20.599, 20.87, 21.14, 21.359, 21.682, 22.187, 22.562, 23.041]}, {"a": 23.686, "b": 25.441, "t": "Now the part almost nobody notices.", "k": ["notices."], "w": [23.736, 23.931, 24.127, 24.369, 24.704, 25.039]}, {"a": 25.441, "b": 27.746, "t": "And it's where your money goes to waste.", "k": ["waste."], "w": [25.491, 25.686, 25.882, 26.17, 26.412, 26.701, 26.943, 27.092]}, {"a": 27.746, "b": 29.589, "t": "Green grass looks dull to them too.", "k": ["Green"], "w": [27.796, 28.097, 28.399, 28.7, 28.953, 29.109, 29.362]}, {"a": 29.589, "b": 32.106, "t": "So a red ball on the lawn almost blends in.", "k": ["almost"], "w": [29.639, 29.795, 29.901, 30.106, 30.359, 30.514, 30.718, 30.971, 31.321, 31.671]}, {"a": 32.106, "b": 35.059000000000005, "t": "That bright toy you paid for is hard for your dog to spot.", "k": ["paid"], "w": [32.156, 32.403, 32.746, 32.945, 33.145, 33.392, 33.592, 33.744, 33.991, 34.191, 34.438, 34.638, 34.79]}, {"a": 35.059000000000005, "b": 37.126000000000005, "t": "That's why it may run right past it.", "k": ["That's"], "w": [35.109, 35.403, 35.603, 35.755, 35.955, 36.155, 36.449, 36.697]}, {"a": 37.126000000000005, "b": 39.389, "t": "So for games outside, pick blue or yellow.", "k": ["outside,"], "w": [37.176, 37.335, 37.543, 37.851, 38.332, 38.59, 38.848, 39.007]}, {"a": 39.389, "b": 41.616, "t": "Those are the colors dogs see best.", "k": ["colors"], "w": [39.439, 39.747, 39.955, 40.164, 40.521, 40.779, 40.987]}, {"a": 41.616, "b": 43.889, "t": "Tell me what color your dog's favorite toy is.", "k": ["favorite"], "w": [41.666, 41.911, 42.061, 42.306, 42.598, 42.842, 43.087, 43.52, 43.718]}, {"a": 43.889, "b": 46.830000000000005, "t": "Follow to decode your dog.", "k": ["Follow"], "w": [43.939, 44.278, 44.428, 44.767, 45.012]}], "T": {"fin": 46.88, "s_fin": 46.88, "x_see": 2.726, "x_wrong": 5.608, "x_black": 8.762, "x_sci": 10.723, "x_dogs3": 12.46, "x_color3": 13.124, "x_three": 15.298, "x_dogs4": 17.265, "x_two": 17.994, "x_blues": 19.281, "x_yellows": 19.823, "x_reds": 20.328, "x_muddy": 21.359, "x_dull": 28.7, "x_red7": 29.901, "x_blends": 31.321, "x_hard": 33.744, "x_run": 35.955, "x_past": 36.449, "x_blue": 38.59, "x_yellow": 39.007, "x_those": 39.439, "x_tell": 41.546, "s_cta": 43.939, "c01b": 1.754, "c02": 6.536, "c03": 9.656, "c04": 14.786000000000001, "c05": 18.395999999999997, "c06": 23.616, "c07": 32.036, "c08":