{"frases": [{"a": 0, "b": 2.309, "t": "Scientists chased this signal for 17 years.", "k": ["17", "years."], "w": [0.056, 0.561, 0.885, 1.119, 1.444, 1.633, 2.012]}, {"a": 2.309, "b": 5.314, "t": "It looked like the mysterious bursts that come from deep space.", "k": ["mysterious"], "w": [2.359, 2.503, 2.827, 3.062, 3.251, 3.756, 4.08, 4.314, 4.549, 4.783, 5.017]}, {"a": 5.314, "b": 8.165999999999999, "t": "Careful, the answer was closer than anyone imagined.", "k": ["imagined."], "w": [5.364, 5.802, 5.991, 6.315, 6.505, 6.829, 7.063, 7.388]}, {"a": 8.165999999999999, "b": 11.253, "t": "In 1998, a giant radio telescope in Parkes,", "k": ["1998,"], "w": [8.216, 8.397, 9.232, 9.356, 9.706, 10.056, 10.632, 10.812]}, {"a": 11.253, "b": 14.286, "t": "Australia, started picking up strange signals.", "k": ["Australia,"], "w": [11.303, 11.964, 12.426, 12.889, 13.07, 13.533]}, {"a": 14.286, "b": 17.146, "t": "Each one lasted just a few thousandths of a second.", "k": ["thousandths"], "w": [14.336, 14.584, 14.785, 15.129, 15.378, 15.483, 15.683, 16.266, 16.419, 16.524]}, {"a": 17.146, "b": 19.496, "t": "They looked a lot like fast radio bursts,", "k": ["bursts,"], "w": [17.196, 17.473, 17.857, 17.974, 18.198, 18.475, 18.752, 19.083]}, {"a": 19.496, "b": 22.646, "t": "real flashes that come from far outside our galaxy.", "k": ["flashes"], "w": [19.546, 19.823, 20.26, 20.537, 20.815, 21.092, 21.316, 21.753, 21.976]}, {"a": 22.646, "b": 23.855, "t": "But these had a problem.", "k": ["problem."], "w": [22.696, 22.888, 23.171, 23.362, 23.463]}, {"a": 23.855, "b": 26.496, "t": "No other telescope in the world could see them.", "k": ["telescope"], "w": [23.905, 24.051, 24.334, 24.799, 24.945, 25.137, 25.42, 25.703, 25.894]}, {"a": 26.496, "b": 29.021, "t": "Now the answer that was closer than anyone imagined.", "k": ["imagined."], "w": [26.546, 26.738, 26.93, 27.258, 27.496, 27.688, 28.016, 28.254, 28.583]}, {"a": 29.021, "b": 31.016, "t": "And one clue was the time of day.", "k": ["clue"], "w": [29.071, 29.263, 29.455, 29.692, 29.884, 30.076, 30.314, 30.46]}, {"a": 31.016, "b": 33.256, "t": "The signals kept showing up around lunchtime.", "k": ["lunchtime."], "w": [31.066, 31.24, 31.58, 31.795, 32.135, 32.267, 32.565]}, {"a": 33.256, "b": 34.224000000000004, "t": "In 2015,", "k": ["2015,"], "w": [33.306, 33.478]}, {"a": 34.224000000000004, "b": 37.77, "t": "a student named Emily Petroff and her team added a new sensor.", "k": ["student"], "w": [34.274, 34.393, 34.834, 35.167, 35.501, 35.942, 36.168, 36.394, 36.674, 37.007, 37.126, 37.352]}, {"a": 37.77, "b": 41.786, "t": "It caught the signals at the same frequency a microwave oven uses.", "k": ["frequency"], "w": [37.82, 37.992, 38.379, 38.605, 39.046, 39.218, 39.444, 39.724, 40.273, 40.391, 40.94, 41.22]}, {"a": 41.786, "b": 44.258, "t": "So they tested the microwave in the staff kitchen.", "k": ["microwave"], "w": [41.836, 41.984, 42.226, 42.559, 42.754, 43.227, 43.375, 43.57, 43.858]}, {"a": 44.258, "b": 46.206, "t": "Heating food normally did nothing.", "k": ["normally"], "w": [44.308, 44.688, 44.929, 45.355, 45.55]}, {"a": 46.206, "b": 48.206, "t": "Then they opened the door before it finished.", "k": ["finished."], "w": [46.256, 46.472, 46.688, 46.988, 47.163, 47.379, 47.678, 47.811]}, {"a": 48.206, "b": 49.556000000000004, "t": "And the signal appeared.", "k": ["appeared."], "w": [48.256, 48.431, 48.606, 48.905]}, {"a": 49.556000000000004, "b": 52.385000000000005, "t": "So for 17 years, the mystery wasn't in deep space.", "k": ["17", "years,"], "w": [49.606, 49.762, 49.966, 50.374, 50.748, 50.953, 51.351, 51.653, 51.808, 52.061]}, {"a": 52.385000000000005, "b": 54.486000000000004, "t": "It was someone in a hurry to eat.", "k": ["someone"], "w": [52.435, 52.591, 52.795, 53.193, 53.349, 53.456, 53.757, 53.913]}, {"a": 54.486000000000004, "b": 56.499, "t": "Tell me if you'd have guessed the microwave.", "k": ["microwave."], "w": [54.536, 54.763, 54.903, 55.043, 55.27, 55.497, 55.855, 56.038]}, {"a": 56.499, "b": 59.300000000000004, "t": "Follow for the next case.", "k": ["Follow"], "w": [56.549, 56.864, 57.047, 57.23, 57.457]}], "T": {"fin": 59.35, "s_fin": 59.35, "x_tell": 54.416000000000004, "s_cta": 56.549, "x_17": 1.633, "x_bursts": 3.756, "x_careful": 5.364, "x_closer": 6.505, "x_parkes": 10.812, "x_strange": 13.07, "x_frb": 18.475, "x_real": 19.546, "x_outside": 21.316, "x_noother": 23.905, "x_closer6": 27.688, "x_clue": 29.455, "x_time": 30.076, "x_lunch": 32.565, "x_emily": 35.167, "x_sensor": 37.352, "x_caught": 37.992, "x_freq": 39.724, "x_microwave": 40.391, "x_tested": 42.226, "x_nothing": 45.55, "x_opened": 46.688, "x_appeared": 48.905, "x_wasnt": 51.351, "x_hurry": 53.456, "c02": 8.096, "c03": 14.216000000000001, "c04": 17.076, "c05": 22.576, "c06": 26.426, "c07": 30.945999999999998, "c08": 33.186, "c09": 41.716, "c10": 46.136, "c11": 49.486000000000004, "c12": 54.416000000000004}, "marca": "THE RABBIT LOOP", "tema": "espacio", "escenas": [{"tipo": "pelicula", "desde": "0", "luz": false, "p27_fija": true, "escala": 1.24, "zoom": [{"k": -1, "s": 1.0, "dur": 0.01, "y": 1200}], "zonas": [{"x0": 100000, "x1": 101300, "cam": 100000, "set": "dc_srabbit18_p01", "entorno": "dc_srabbit18_p01", "transicion": "inicio", "camara": "fija", "acabado": "ninguno", "razon": "línea 1 · gancho"}, {"x0": 102600, "x1": 103900, "cam": 102600, "set": "dc_srabbit18_p02", "entorno": "dc_srabbit18_p02", "transicion": "corte", "camara": "fija", "acabado": "ninguno", "razon": "línea 2", "k": "c02"}, {"x0": 105200, "x1": 106500, "cam": 105200, "set": "dc_srabbit18_p03", "entorno": "dc_srabbit18_p03", "transicion": "corte", "camara": "fija", "acabado": "ninguno", "razon": "línea 3", "k": "c03"}, {"x0": 107800, "x1": 109100, "cam": 107800, "set": "dc_srabbit18_p04", "entorno": "dc_srabbit18_p04", "transicion": "corte", "camara": "fija", "acabado": "ninguno", "razon": "línea 4", "k": "c04"}, {"x0": 110400, "x1": 111700, "cam": 110400, "set": "dc_srabbit18_p05", "entor