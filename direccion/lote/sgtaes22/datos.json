{"frases": [{"a": 0, "b": 2.54, "t": "Hay una PS5 de GTA 6 que no puedes comprar.", "k": ["PS5", "6"], "w": [0.056, 0.267, 0.477, 0.738, 0.899, 1.11, 1.371, 1.581, 1.742, 2.103]}, {"a": 2.54, "b": 4.617, "t": "Rockstar no la vende, a ningún precio.", "k": ["Rockstar"], "w": [2.59, 3.052, 3.212, 3.373, 3.759, 3.869, 4.231]}, {"a": 4.617, "b": 7.146, "t": "Y lo más raro es a quiénes se la dieron.", "k": ["quiénes"], "w": [4.667, 4.778, 4.938, 5.149, 5.41, 5.57, 5.681, 6.092, 6.253, 6.413]}, {"a": 7.146, "b": 10.766, "t": "Apareció en noviembre de 2026, justo antes del lanzamiento.", "k": ["2026,"], "w": [7.196, 7.633, 7.784, 8.268, 8.42, 9.122, 9.417, 9.711, 9.91]}, {"a": 10.766, "b": 12.027999999999999, "t": "Es una PS5 Pro oscura,", "k": ["PS5"], "w": [10.816, 10.974, 11.182, 11.44, 11.648]}, {"a": 12.027999999999999, "b": 15.636, "t": "con palmeras grabadas y franjas que van del turquesa al magenta.", "k": ["palmeras"], "w": [12.078, 12.286, 12.742, 13.197, 13.306, 13.712, 13.92, 14.128, 14.336, 14.791, 14.95]}, {"a": 15.636, "b": 17.0, "t": "Viene en una maleta rígida,", "k": ["rígida,"], "w": [15.686, 15.973, 16.12, 16.315, 16.647]}, {"a": 17.0, "b": 19.636, "t": "con dos controles a juego y una copia del juego.", "k": ["controles"], "w": [17.05, 17.244, 17.438, 17.909, 18.011, 18.298, 18.399, 18.593, 18.88, 19.074]}, {"a": 19.636, "b": 21.945999999999998, "t": "Muchos fans pidieron que saliera a la venta.", "k": ["pidieron"], "w": [19.686, 19.986, 20.203, 20.587, 20.762, 21.104, 21.195, 21.329]}, {"a": 21.945999999999998, "b": 25.116, "t": "Ahora, lo más raro: a quiénes se la dieron, y cuántas existen.", "k": ["existen."], "w": [21.996, 22.319, 22.453, 22.629, 22.909, 23.002, 23.345, 23.479, 23.613, 23.978, 24.07, 24.414]}, {"a": 25.116, "b": 26.919, "t": "Las primeras no fueron para gamers.", "k": ["primeras"], "w": [25.166, 25.367, 25.807, 25.96, 26.304, 26.553]}, {"a": 26.919, "b": 30.676, "t": "Fueron para basquetbolistas del Miami Heat, un día antes del estreno.", "k": ["basquetbolistas"], "w": [26.969, 27.313, 27.562, 28.337, 28.538, 28.834, 29.155, 29.308, 29.509, 29.805, 30.006]}, {"a": 30.676, "b": 33.436, "t": "Después llegaron a streamers y creadores de contenido.", "k": ["contenido."], "w": [30.726, 31.086, 31.489, 31.586, 32.033, 32.129, 32.577, 32.717]}, {"a": 33.436, "b": 35.676, "t": "Cada una trae su propio número de serie.", "k": ["propio"], "w": [33.486, 33.725, 33.919, 34.158, 34.305, 34.637, 34.968, 35.116]}, {"a": 35.676, "b": 39.016000000000005, "t": "Y según los reportes, existen solo unas 100 en todo el mundo.", "k": ["100"], "w": [35.726, 35.819, 36.082, 36.26, 36.713, 37.06, 37.281, 37.501, 37.992, 38.128, 38.348, 38.484]}, {"a": 39.016000000000005, "b": 41.396, "t": "Rockstar ya dijo que no llegará a las tiendas.", "k": ["Rockstar"], "w": [39.066, 39.462, 39.6, 39.824, 40.005, 40.143, 40.496, 40.591, 40.772]}, {"a": 41.396, "b": 43.414, "t": "O sea, es una consola que no se compra.", "k": ["consola"], "w": [41.446, 41.55, 41.818, 41.969, 42.167, 42.554, 42.752, 42.903, 43.054]}, {"a": 43.414, "b": 45.056000000000004, "t": "Te la tienen que regalar.", "k": ["regalar."], "w": [43.464, 43.614, 43.765, 44.105, 44.303]}, {"a": 45.056000000000004, "b": 46.833000000000006, "t": "Comenta cuánto pagarías por una.", "k": ["pagarías"], "w": [45.106, 45.528, 45.899, 46.373, 46.59]}, {"a": 46.833000000000006, "b": 50.370000000000005, "t": "Sigue el canal para más de GTA 6.", "k": ["6."], "w": [46.883, 47.203, 47.367, 47.687, 47.955, 48.171, 48.336, 48.552]}], "T": {"fin": 50.42, "s_fin": 50.42, "x_tell": 44.986000000000004, "s_cta": 46.883, "x_comprar": 2.103, "x_rockstar": 2.59, "x_precio": 4.231, "x_raro": 5.149, "x_dieron": 6.413, "x_nov": 7.784, "x_2026": 8.42, "x_antes": 9.417, "x_oscura": 11.648, "x_palmeras": 12.286, "x_franjas": 13.306, "x_turquesa": 14.336, "x_magenta": 14.95, "x_maleta": 16.315, "x_dos": 17.244, "x_copia": 18.593, "x_fans": 19.986, "x_venta": 21.329, "x_ahora": 21.996, "x_quienes":