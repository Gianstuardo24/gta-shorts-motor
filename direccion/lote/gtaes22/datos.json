{"frases": [{"a": 0, "b": 1.772, "t": "La prensa se rindió ante GTA 6.", "k": ["6."], "w": [0.056, 0.216, 0.575, 0.734, 1.094, 1.353, 1.562]}, {"a": 1.772, "b": 4.291, "t": "Y lo hizo de una forma que nadie había logrado.", "k": ["logrado."], "w": [1.822, 1.932, 2.091, 2.351, 2.51, 2.72, 3.029, 3.238, 3.548, 3.857]}, {"a": 4.291, "b": 7.046, "t": "Pero hay un detalle que casi nadie te cuenta.", "k": ["detalle"], "w": [4.341, 4.6, 4.81, 4.969, 5.378, 5.588, 5.847, 6.156, 6.316]}, {"a": 7.046, "b": 10.016, "t": "Las reseñas de la prensa salieron el 18 de noviembre.", "k": ["18"], "w": [7.096, 7.281, 7.641, 7.782, 7.923, 8.24, 8.644, 8.785, 9.155, 9.295]}, {"a": 10.016, "b": 12.536999999999999, "t": "En Metacritic, el sitio que promedia a los críticos,", "k": ["Metacritic,"], "w": [10.066, 10.211, 10.784, 10.929, 11.209, 11.399, 11.814, 11.914, 12.103]}, {"a": 12.536999999999999, "b": 14.915999999999999, "t": "sacó una puntuación de 99 de 100.", "k": ["99", "100."], "w": [12.587, 12.822, 13.011, 13.517, 13.662, 14.041, 14.186]}, {"a": 14.915999999999999, "b": 19.636, "t": "Ese puntaje solo lo tenía un juego: Zelda Ocarina of Time, de 1998.", "k": ["1998."], "w": [14.966, 15.2, 15.656, 15.946, 16.124, 16.469, 16.647, 17.076, 17.421, 17.877, 18.055, 18.428, 18.606]}, {"a": 19.636, "b": 22.516, "t": "Para muchos, fue considerado el mejor juego de la historia.", "k": ["considerado"], "w": [19.686, 19.895, 20.245, 20.414, 20.905, 21.033, 21.283, 21.532, 21.661, 21.79]}, {"a": 22.516, "b": 25.176, "t": "Pero ahora, el detalle que casi nadie te cuenta.", "k": ["detalle"], "w": [22.566, 22.798, 23.142, 23.285, 23.652, 23.839, 24.071, 24.348, 24.491]}, {"a": 25.176, "b": 27.811999999999998, "t": "Ocarina llegó a 99 con 22 reseñas.", "k": ["99", "22"], "w": [25.226, 25.683, 26.028, 26.151, 26.619, 26.853, 27.321]}, {"a": 27.811999999999998, "b": 31.016, "t": "En cambio, GTA 6 lo hizo con más de 140.", "k": ["6", "140."], "w": [27.862, 28.04, 28.525, 28.759, 29.049, 29.227, 29.517, 29.751, 29.985, 30.164]}, {"a": 31.016, "b": 35.286, "t": "Con más críticos opinando, es mucho más difícil mantener un promedio tan alto.", "k": ["opinando,"], "w": [31.066, 31.27, 31.474, 31.921, 32.441, 32.597, 32.898, 33.102, 33.501, 33.948, 34.103, 34.55, 34.754]}, {"a": 35.286, "b": 38.806000000000004, "t": "O sea, el mismo número, pero con seis veces más críticos opinando.", "k": ["opinando."], "w": [35.336, 35.437, 35.7, 35.847, 36.132, 36.533, 36.772, 36.966, 37.205, 37.491, 37.684, 38.107]}, {"a": 38.806000000000004, "b": 41.376000000000005, "t": "Esto, sin duda, es una cifra a tener en cuenta.", "k": ["cuenta."], "w": [38.856, 39.145, 39.327, 39.616, 39.754, 39.936, 40.203, 40.298, 40.566, 40.704]}, {"a": 41.376000000000005, "b": 44.197, "t": "Comenta si crees que se merece el 99 de 100.", "k": ["99", "100."], "w": [41.426, 41.821, 41.975, 42.273, 42.475, 42.629, 42.976, 43.13, 43.534, 43.688]}, {"a": 44.197, "b": 46.555, "t": "Y si no, en cuánto lo calificarías y por qué.", "k": ["calificarías"], "w": [44.247, 44.353, 44.507, 44.733, 44.887, 45.234, 45.388, 46.023, 46.129, 46.331]}, {"a": 46.555, "b": 50.36, "t": "Sigue el canal para más números de GTA 6.", "k": ["6."], "w": [46.605, 46.904, 47.058, 47.356, 47.607, 47.809, 48.203, 48.358, 48.56]}], "T": {"fin": 50.41, "s_fin": 50.41, "x_rin": 0.734, "x_ylo": 1.822, "x_pero": 4.341, "x_det": 4.969, "x_18": 8.785, "x_prom": 11.399, "x_99": 13.662, "x_100": 14.186, "x_zelda": 17.076, "x_1998": 18.606, "x_mejor": 21.033, "s_7": 25.105999999999998, "x_99b": 26.151, "x_22": 26.853, "x_cambio": 28.04, "x_140": 30.164, "x_dificil": 33.102, "s_9": 35.216, "x_mismo": 35.847, "x_seis": 36.966, "x_tell": 41.306000000000004, "s_cta": 46.605, "c02a": 6.976, "c02b": 9.946000000000002, "c03": 14.846, "c04": 22.445999999999998, "c06": 30.945999999999998, "c07": 38.736000000000004}, "marca": "VICEVERSO GG", "tema": null, "escenas": [{"tipo": "pelicula", "desde": "0", "luz": false, "p27_fija": true, "escala": 1.24, "zoom