{"frases": [{"a": 0, "b": 1.7269999999999999, "t": "This parrot knows where the money is.", "k": ["parrot"], "w": [0.056, 0.28, 0.591, 0.858, 1.126, 1.307, 1.575]}, {"a": 1.7269999999999999, "b": 3.906, "t": "Lots of players walk past it and miss the cash.", "k": ["players"], "w": [1.777, 2.002, 2.14, 2.494, 2.718, 2.942, 3.08, 3.262, 3.486, 3.667]}, {"a": 3.906, "b": 6.776, "t": "But there's more hidden there than the parrot tells you.", "k": ["there's"], "w": [3.956, 4.137, 4.448, 4.672, 4.983, 5.25, 5.475, 5.656, 5.967, 6.234]}, {"a": 6.776, "b": 9.235999999999999, "t": "It's right at the start of the game, in Key Lento.", "k": ["Lento."], "w": [6.826, 7.0, 7.257, 7.389, 7.563, 7.82, 7.953, 8.127, 8.404, 8.537, 8.711]}, {"a": 9.235999999999999, "b": 10.953, "t": "Your neighbor Shirley sends you to buy", "k": ["neighbor"], "w": [9.286, 9.507, 9.898, 10.247, 10.51, 10.689, 10.825]}, {"a": 10.953, "b": 13.126, "t": "rum at a store called Three Sheets Liquor.", "k": ["store"], "w": [11.003, 11.182, 11.318, 11.411, 11.675, 11.981, 12.244, 12.55]}, {"a": 13.126, "b": 15.386, "t": "Lots of players grab the bottle and leave.", "k": ["players"], "w": [13.176, 13.407, 13.549, 13.914, 14.145, 14.331, 14.651, 14.838]}, {"a": 15.386, "b": 15.972999999999999, "t": "But listen.", "k": ["listen."], "w": [15.436, 15.627]}, {"a": 15.972999999999999, "b": 18.326, "t": "You can hear animals somewhere in the back.", "k": ["somewhere"], "w": [16.023, 16.214, 16.405, 16.642, 17.015, 17.479, 17.624, 17.815]}, {"a": 18.326, "b": 22.052, "t": "Behind the store, there's a hidden yard full of smuggled exotic animals.", "k": ["store,"], "w": [18.376, 18.732, 18.939, 19.32, 19.676, 19.784, 20.14, 20.397, 20.654, 20.812, 21.267, 21.623]}, {"a": 22.052, "b": 23.866, "t": "And a few guys guarding it.", "k": ["guarding"], "w": [22.102, 22.31, 22.419, 22.626, 22.883, 23.338]}, {"a": 23.866, "b": 25.645, "t": "Now the part the parrot doesn't tell you,", "k": ["doesn't"], "w": [23.916, 24.089, 24.263, 24.477, 24.651, 24.948, 25.245, 25.46]}, {"a": 25.645, "b": 27.695999999999998, "t": "and it's where the rest of the cash is.", "k": ["where"], "w": [25.695, 25.869, 26.042, 26.298, 26.471, 26.686, 26.818, 26.991, 27.206]}, {"a": 27.695999999999998, "b": 29.374, "t": "In one cage, there's a red parrot.", "k": ["there's"], "w": [27.746, 27.894, 28.087, 28.396, 28.728, 28.829, 29.023]}, {"a": 29.374, "b": 32.746, "t": "Ask it about the cash, and it tells you to check the generator.", "k": ["generator."], "w": [29.424, 29.618, 29.765, 30.051, 30.244, 30.553, 30.747, 30.894, 31.18, 31.374, 31.521, 31.807, 32.001]}, {"a": 32.746, "b": 34.661, "t": "Look at the wall vent right next to it.", "k": ["right"], "w": [32.796, 33.031, 33.176, 33.366, 33.602, 33.837, 34.118, 34.353, 34.498]}, {"a": 34.661, "b": 37.026, "t": "Inside, there's about 1,300 dollars.", "k": ["1,300", "dollars."], "w": [34.711, 35.104, 35.43, 35.711, 36.381]}, {"a": 37.026, "b": 38.0, "t": "But don't leave yet.", "k": ["don't"], "w": [37.076, 37.268, 37.506, 37.789]}, {"a": 38.0, "b": 41.256, "t": "The back room has a safe and a money counter, with even more.", "k": ["counter,"], "w": [38.05, 38.242, 38.48, 38.718, 38.91, 39.01, 39.248, 39.44, 39.541, 39.824, 40.268, 40.506, 40.744]}, {"a": 41.256, "b": 43.273, "t": "So one talking parrot can hand you over", "k": ["talking"], "w": [41.306, 41.461, 41.665, 42.063, 42.412, 42.615, 42.868, 43.071]}, {"a": 43.273, "b": 46.466, "t": "2,000 dollars before the story even gets going.", "k": ["2,000", "dollars"], "w": [43.323, 44.041, 44.439, 44.788, 44.992, 45.292, 45.544, 45.797]}, {"a": 46.466, "b": 48.741, "t": "Tell me if you found the parrot on your own.", "k": ["parrot"], "w": [46.516, 46.765, 46.918, 47.071, 47.273, 47.569, 47.771, 48.115, 48.269, 48.518]}, {"a": 48.741, "b": 52.050000000000004, "t": "Follow for more GTA 6 secrets.", "k": ["6"], "w": [48.791, 49.135, 49.336, 49.585, 49.787, 50.036]}], "T": {"fin": 52.1, "s_fin": 52.1, "x_tell": 46.396