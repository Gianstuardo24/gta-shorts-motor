{"frases": [{"a": 0, "b": 1.822, "t": "Don't trust the flying saucer story.", "k": ["flying"], "w": [0.056, 0.306, 0.605, 0.807, 1.154, 1.501]}, {"a": 1.822, "b": 4.47, "t": "Everyone has heard it, but few know how it started.", "k": ["Everyone"], "w": [1.872, 2.315, 2.517, 2.815, 3.042, 3.244, 3.446, 3.697, 3.899, 4.053]}, {"a": 4.47, "b": 6.7860000000000005, "t": "And the real story might surprise you.", "k": ["surprise"], "w": [4.52, 4.723, 4.925, 5.175, 5.474, 5.772, 6.215]}, {"a": 6.7860000000000005, "b": 12.225999999999999, "t": "In June 1947, pilot Kenneth Arnold saw nine shiny objects near Mount Rainier.", "k": ["1947,"], "w": [6.836, 7.021, 7.321, 8.177, 8.535, 9.009, 9.425, 9.668, 9.968, 10.327, 10.801, 11.101, 11.459]}, {"a": 12.225999999999999, "b": 13.072, "t": "They were fast.", "k": ["fast."], "w": [12.276, 12.533, 12.79]}, {"a": 13.072, "b": 15.716, "t": "Faster, he said, than any plane of his time.", "k": ["Faster,"], "w": [13.122, 13.552, 13.71, 14.041, 14.298, 14.506, 14.813, 14.971, 15.179]}, {"a": 15.716, "b": 18.396, "t": "He said they moved like a saucer skipping across water.", "k": ["skipping"], "w": [15.766, 15.899, 16.114, 16.33, 16.586, 16.802, 16.893, 17.191, 17.573, 17.871]}, {"a": 18.396, "b": 20.163999999999998, "t": "He was describing how they moved.", "k": ["describing"], "w": [18.446, 18.604, 18.812, 19.367, 19.575, 19.832]}, {"a": 20.163999999999998, "b": 21.316, "t": "Not their shape.", "k": ["shape."], "w": [20.214, 20.422, 20.729]}, {"a": 21.316, "b": 24.855999999999998, "t": "But the papers ran it as flying saucers, and the name stuck.", "k": ["saucers,"], "w": [21.366, 21.574, 21.783, 22.14, 22.348, 22.507, 22.665, 23.023, 23.504, 23.712, 23.92, 24.178]}, {"a": 24.855999999999998, "b": 27.826, "t": "Now watch what one headline did to an entire country.", "k": ["country."], "w": [24.906, 25.101, 25.389, 25.631, 25.826, 26.253, 26.448, 26.597, 26.745, 27.08]}, {"a": 27.826, "b": 32.076, "t": "Within weeks, hundreds of people across the US reported flying saucers.", "k": ["hundreds"], "w": [27.876, 28.258, 28.667, 29.156, 29.326, 29.708, 30.091, 30.314, 30.484, 30.972, 31.355]}, {"a": 32.076, "b": 33.489000000000004, "t": "Many described round discs.", "k": ["described"], "w": [32.126, 32.377, 32.869, 33.168]}, {"a": 33.489000000000004, "b": 36.446000000000005, "t": "The shape from the headline, not the one Arnold saw.", "k": ["headline,"], "w": [33.539, 33.742, 34.041, 34.292, 34.494, 35.01, 35.213, 35.415, 35.618, 35.965]}, {"a": 36.446000000000005, "b": 40.804, "t": "Arnold's own drawing showed something flat and crescent shaped, almost like a boomerang.", "k": ["boomerang."], "w": [36.496, 36.886, 37.086, 37.476, 37.819, 38.304, 38.551, 38.751, 39.189, 39.603, 39.945, 40.193, 40.297]}, {"a": 40.804, "b": 42.026, "t": "Not a round plate.", "k": ["plate."], "w": [40.854, 41.054, 41.159, 41.454]}, {"a": 42.026, "b": 45.603, "t": "So the classic flying saucer we all picture started as a headline.", "k": ["picture"], "w": [42.076, 42.24, 42.455, 42.874, 43.243, 43.611, 43.775, 43.99, 44.409, 44.829, 44.993, 45.105]}, {"a": 45.603, "b": 49.326, "t": "Not as something someone actually saw, like many people think.", "k": ["something"], "w": [45.653, 45.868, 46.031, 46.553, 46.973, 47.444, 47.735, 48.001, 48.268, 48.636]}, {"a": 49.326, "b": 51.524, "t": "Tell me if you knew where the name came from.", "k": ["where"], "w": [49.376, 49.612, 49.757, 49.902, 50.092, 50.328, 50.609, 50.799, 51.035, 51.27]}, {"a": 51.524, "b": 54.370000000000005, "t": "Follow for the next case.", "k": ["Follow"], "w": [51.574, 51.9, 52.09, 52.281, 52.516]}], "T": {"fin": 54.42, "s_fin": 54.42, "x_few": 3.244, "c01b": 6.716, "x_nine": 9.668, "x_faster": 13.122, "x_saucer": 16.893, "x_not": 20.214, "x_stuck": 24.178, "x_one": 25.631, "x_within": 27.876, "x_shape": 33.742, "x_notone": 35.01, "x_something": 37.819, "x_boom": 40.297, "x_notround": 40.854, "x_so11": 42.076, "x_headline11": 45.105, "x_not11": 45.653, "x_te