{"frases": [{"a": 0, "b": 1.8319999999999999, "t": "Los jugadores castigaron a GTA 6.", "k": ["6."], "w": [0.056, 0.262, 0.763, 1.313, 1.421, 1.627]}, {"a": 1.8319999999999999, "b": 5.303, "t": "La prensa le dio 99 de 100 y el público, menos de 6.", "k": ["99", "100", "6."], "w": [1.882, 2.039, 2.393, 2.55, 2.756, 3.168, 3.325, 3.895, 4.003, 4.16, 4.636, 4.94, 5.097]}, {"a": 5.303, "b": 8.216, "t": "Pero esa nota esconde algo que casi nadie revisa.", "k": ["esconde"], "w": [5.353, 5.608, 5.814, 6.069, 6.472, 6.727, 6.933, 7.189, 7.493]}, {"a": 8.216, "b": 12.596, "t": "En Metacritic, más de 150 críticos lo dejaron en 99 de 100.", "k": ["150", "99", "100."], "w": [8.266, 8.427, 9.067, 9.278, 9.439, 10.023, 10.487, 10.648, 11.061, 11.222, 11.645, 11.806]}, {"a": 12.596, "b": 15.366, "t": "Pero ese sitio tiene otra nota: la de los usuarios.", "k": ["usuarios."], "w": [12.646, 12.884, 13.076, 13.359, 13.642, 13.88, 14.186, 14.333, 14.479, 14.671]}, {"a": 15.366, "b": 18.855999999999998, "t": "Se abrió el 20 de noviembre, un día y medio después del lanzamiento.", "k": ["20"], "w": [15.416, 15.549, 15.807, 15.94, 16.289, 16.422, 16.908, 17.041, 17.216, 17.307, 17.565, 17.906, 18.081]}, {"a": 18.855999999999998, "b": 21.676, "t": "Y en pocas horas cayó hasta 4,9 de 10.", "k": ["4,9", "10."], "w": [18.906, 19.017, 19.178, 19.489, 19.801, 20.063, 20.374, 20.797, 20.958]}, {"a": 21.676, "b": 24.986, "t": "Ahora, lo que casi nadie revisa: quiénes pusieron esas notas.", "k": ["pusieron"], "w": [21.726, 22.074, 22.219, 22.409, 22.645, 22.925, 23.319, 23.69, 24.106, 24.342]}, {"a": 24.986, "b": 26.854, "t": "En Metacritic, cualquiera puede votar.", "k": ["Metacritic,"], "w": [25.036, 25.182, 25.76, 26.271, 26.553]}, {"a": 26.854, "b": 29.256, "t": "No hace falta demostrar que tienes el juego.", "k": ["demostrar"], "w": [26.904, 27.05, 27.287, 27.569, 28.034, 28.225, 28.553, 28.699]}, {"a": 29.256, "b": 31.206, "t": "Miles de esas notas fueron un cero.", "k": ["fueron"], "w": [29.306, 29.583, 29.726, 29.959, 30.236, 30.558, 30.701]}, {"a": 31.206, "b": 35.39, "t": "Y hubo respuesta: fans de GTA fueron a bajarle la nota a Zelda Ocarina of Time,", "k": ["respuesta:"], "w": [31.256, 31.365, 31.624, 32.205, 32.464, 32.623, 32.831, 33.189, 33.299, 33.706, 33.865, 34.123, 34.233, 34.541, 34.948, 35.107]}, {"a": 35.39, "b": 37.356, "t": "el juego que comparte el 99.", "k": ["99."], "w": [35.44, 35.599, 35.908, 36.116, 36.574, 36.733]}, {"a": 37.356, "b": 38.591, "t": "También hay quejas reales,", "k": ["También"], "w": [37.406, 37.764, 37.947, 38.261]}, {"a": 38.591, "b": 41.766000000000005, "t": "como que corre a 30 cuadros por segundo y algunos errores.", "k": ["30"], "w": [38.641, 38.868, 39.051, 39.322, 39.418, 39.784, 40.142, 40.325, 40.683, 40.779, 41.137]}, {"a": 41.766000000000005, "b": 45.076, "t": "O sea, esa nota mezcla quejas reales con una guerra entre fans.", "k": ["mezcla"], "w": [41.816, 41.913, 42.163, 42.348, 42.577, 42.893, 43.21, 43.527, 43.711, 43.896, 44.213, 44.485]}, {"a": 45.076, "b": 47.132000000000005, "t": "Comenta qué nota le pones tú y por qué.", "k": ["tú"], "w": [45.126, 45.525, 45.729, 45.982, 46.137, 46.438, 46.594, 46.701, 46.905]}, {"a": 47.132000000000005, "b": 50.56, "t": "Sigue el canal para más de GTA 6.", "k": ["6."], "w": [47.182, 47.484, 47.639, 47.941, 48.193, 48.398, 48.553, 48.757]}], "T": {"fin": 50.61, "s_fin": 50.61, "x_tell": 45.006, "s_cta": 47.182, "x_castig": 0.763, "x_prensa": 2.039, "x_99": 2.756, "x_publico": 4.16, "x_menos": 4.636, "x_esconde": 6.069, "x_nadie": 7.189, "x_meta": 8.427, "x_150": 9.439, "x_dejaron": 10.648, "x_99b": 11.222, "x_otra": 13.642, "x_usuarios": 14.671, "x_20": 15.94, "x_nov": 16.422, "x_dia": 17.041, "x_lanz": 18.081, "x_horas": 19.489, "x_cayo": 19.801, "x_49": 20.374, "x_ahora": 21.726, "x_revisa": 22.925, "x_quienes": 23.319, "x_cualq": 25.76, "x_votar": 26.553, "x_nohace": 27.05, "x_juego": 28.699, "x_miles": 29.306, "x_cero": 30.701, "x_resp": 31.624, "x_fans": 