{"frases": [{"a": 0, "b": 2.371, "t": "Your brain is lying about this Mars photo.", "k": ["photo."], "w": [0.056, 0.329, 0.654, 0.822, 1.147, 1.472, 1.744, 2.017]}, {"a": 2.371, "b": 6.33, "t": "NASA took it in 1976 and people everywhere saw the same thing.", "k": ["1976"], "w": [2.421, 2.693, 2.966, 3.134, 3.302, 4.078, 4.298, 4.676, 5.263, 5.483, 5.703, 5.976]}, {"a": 6.33, "b": 10.235999999999999, "t": "What few people know is that NASA itself helped start the story.", "k": ["people"], "w": [6.38, 6.652, 6.873, 7.25, 7.523, 7.691, 7.963, 8.236, 8.613, 8.991, 9.316, 9.536]}, {"a": 10.235999999999999, "b": 14.309999999999999, "t": "In July 1976, the Viking 1 spacecraft was circling Mars,", "k": ["1976,", "1"], "w": [10.286, 10.469, 10.767, 11.615, 11.856, 12.268, 12.566, 13.208, 13.449, 13.976]}, {"a": 14.309999999999999, "b": 16.256, "t": "looking for a landing site.", "k": ["looking"], "w": [14.36, 14.83, 15.07, 15.196, 15.666]}, {"a": 16.256, "b": 18.492, "t": "One photo showed a hill more than a mile long.", "k": ["showed"], "w": [16.306, 16.496, 16.776, 17.101, 17.2, 17.435, 17.67, 17.905, 18.004, 18.239]}, {"a": 18.492, "b": 20.445999999999998, "t": "With two eyes, a nose and a mouth.", "k": ["mouth."], "w": [18.542, 18.777, 18.966, 19.269, 19.368, 19.603, 19.793, 19.892]}, {"a": 20.445999999999998, "b": 23.346, "t": "Many people saw a giant face staring up from Mars.", "k": ["staring"], "w": [20.496, 20.753, 21.109, 21.316, 21.425, 21.732, 21.989, 22.394, 22.552, 22.809]}, {"a": 23.346, "b": 25.986, "t": "And some became convinced that someone had built it.", "k": ["convinced"], "w": [23.396, 23.57, 23.786, 24.085, 24.508, 24.723, 25.064, 25.238, 25.495]}, {"a": 25.986, "b": 29.916, "t": "Now the part few people know: how NASA itself helped start the story.", "k": ["people"], "w": [26.036, 26.241, 26.445, 26.698, 26.903, 27.253, 27.58, 27.784, 28.037, 28.388, 28.739, 29.041, 29.245]}, {"a": 29.916, "b": 33.446000000000005, "t": "NASA's scientists believed it was just a hill with strange shadows.", "k": ["scientists"], "w": [29.966, 30.257, 30.783, 31.215, 31.366, 31.563, 31.807, 31.911, 32.155, 32.399, 32.784]}, {"a": 33.446000000000005, "b": 35.109, "t": "But when NASA released the photo,", "k": ["released"], "w": [33.496, 33.692, 33.934, 34.176, 34.604, 34.8]}, {"a": 35.109, "b": 37.856, "t": "its own note said the hill resembled a human head.", "k": ["human"], "w": [35.159, 35.354, 35.55, 35.792, 36.034, 36.23, 36.472, 36.947, 37.049, 37.338]}, {"a": 37.856, "b": 38.818000000000005, "t": "That was enough.", "k": ["enough."], "w": [37.906, 38.182, 38.406]}, {"a": 38.818000000000005, "b": 40.866, "t": "The face on Mars became famous.", "k": ["famous."], "w": [38.868, 39.092, 39.368, 39.538, 39.815, 40.197]}, {"a": 40.866, "b": 44.697, "t": "In 1998, a new spacecraft shot it again, ten times sharper.", "k": ["1998,"], "w": [40.916, 41.087, 41.876, 41.994, 42.218, 42.816, 43.093, 43.264, 43.675, 43.899, 44.23]}, {"a": 44.697, "b": 46.986000000000004, "t": "And in 2001, sharper still.", "k": ["2001,"], "w": [44.747, 44.971, 45.142, 45.932, 46.369]}, {"a": 46.986000000000004, "b": 47.998000000000005, "t": "The face was gone.", "k": ["gone."], "w": [47.036, 47.245, 47.505, 47.714]}, {"a": 47.998000000000005, "b": 50.846000000000004, "t": "It was a rocky hill, like many others around it.", "k": ["others"], "w": [48.048, 48.207, 48.417, 48.526, 48.836, 49.169, 49.429, 49.688, 50.047, 50.406]}, {"a": 50.846000000000004, "b": 52.284000000000006, "t": "So nobody built a face.", "k": ["nobody"], "w": [50.896, 51.076, 51.482, 51.832, 51.956]}, {"a": 52.284000000000006, "b": 53.248000000000005, "t": "Your brain did.", "k": ["brain"], "w": [52.334, 52.627, 52.977]}, {"a": 53.248000000000005, "b": 56.696000000000005, "t": "It's wired to find faces, even in rocks and shadows.", "k": ["shadows."], "w": [53.298, 53.535, 53.885, 54.065, 54.359, 54.793, 55.086, 55.266, 55.616, 55.853]}, {"a": 56.696000000000005, "b": 58.926, "t": "Tell me the strangest place you've seen a face.", "k": ["strangest"], "w": [56.746, 56.981, 57.126, 57.316, 57.777, 58.058, 58.338, 58.573, 58.673]}, {"a": 58.926, "b": 61.77, "t": "Follow for the next case.", "k": ["Follow"], "w": [58.976, 59.302, 59.492, 59.682, 59.917]}], "T": {"fin": 61.82, "s_fin": 61.82, "x_tell": 56.626000000000005, "s_cta": 58.976, "x_lying": 0.822, "x_1976": 3.302, "x_everywhere": 4.676, "x_few": 6.652, "x_nasa": 8.236, "x_viking": 11.856, "x_landing": 15.196, "x_mile": 18.004, "x_eyes": 18.966, "x_nose": 19.368, "x_mouth": 19.892, "x_built": 25.238, "x_itself": 28.037, "x_story": 29.245, "x_hill": 31.911, "x_shadows": 32.784, "x_released": 34.176, "x_note": 35.55, "x_head": 37.338, "x_famous": 40.197, "x_1998": 41.087, "x_sharper": 44.23, "x_2001": 45.142, "x_still": 46.369, "x_gone": 47.714, "x_others": 49.688, "x_brain": 52.627, "x_wired": 53.535, "x_rocks": 55.266, "c02": 10.166, "c03": 16.186, "c04": 20.375999999999998, "c05": 23.276, "c06": 25.916, "c07": 29.846, "c08": 33.376000000000005, "c09": 37.786, "c10": 40.796, "c11": 46.916000000000004, "c12": 50.776, "c13": 56.626000000000005}, "marca": "THE RABBIT LOOP", "tema": "espacio", "escenas": [{"tipo": "pelicula", "desde": "0", "luz": false, "p27_fija": true, "escala": 1.24, "zoom": [{"k": -1, "s": 1.0, "dur": 0.01, "y": 1200}], "zonas": [{"x0": 100000, "x1": 101300, "cam": 100000, "set": "dc_srabbit22_p01", "entorno": "dc_srabbit22_p01", "transicion": "inicio", "camara": "fija", "acabado": "ninguno", "razon": "línea 1 · gancho"}, {"x0": 102600, "x1": 103900, "cam": 102600, "set": "dc_srabbit22_p02", "entorno": "dc_srabbit22_p02", "transicion": "corte", "camara": "fija", "acabado": "ninguno", "razon": "línea 2", "k": "c02"}, {"x0": 105200, "x1": 106500, "cam": 105200, "set": "dc_srabbit22_p03", "entorno": "dc_srabbit22_p03", "transicion": "corte", "camara": "fija", "acabado": "ninguno", "razon": "línea 3", "k": "c03"}, {"x0": 107800, "x1": 109100, "cam": 107800, "set": "dc_srabbit22_p04",