{"frases": [{"a": 0, "b": 2.233, "t": "The Pentagon confirmed this video is real.", "k": ["confirmed"], "w": [0.056, 0.264, 0.721, 1.227, 1.485, 1.792, 1.951]}, {"a": 2.233, "b": 4.361, "t": "But wait until you hear the explanation.", "k": ["explanation."], "w": [2.283, 2.492, 2.75, 3.057, 3.265, 3.523, 3.732]}, {"a": 4.361, "b": 7.376, "t": "Careful, the detail at the end might surprise you.", "k": ["Careful,"], "w": [4.411, 4.892, 5.101, 5.458, 5.617, 5.825, 6.033, 6.341, 6.797]}, {"a": 7.376, "b": 8.277999999999999, "t": "In 2019,", "k": ["2019,"], "w": [7.426, 7.586]}, {"a": 8.277999999999999, "b": 12.335999999999999, "t": "sailors on a Navy warship filmed glowing triangles flying over the ship.", "k": ["triangles"], "w": [8.328, 8.739, 8.899, 9.009, 9.27, 9.68, 10.041, 10.452, 10.963, 11.323, 11.584, 11.794]}, {"a": 12.335999999999999, "b": 14.104, "t": "The video leaked in 2021,", "k": ["2021,"], "w": [12.386, 12.595, 12.902, 13.26, 13.419]}, {"a": 14.104, "b": 17.056, "t": "and the Pentagon confirmed its own sailors shot it.", "k": ["confirmed"], "w": [14.154, 14.362, 14.571, 15.028, 15.534, 15.743, 15.951, 16.358, 16.617]}, {"a": 17.056, "b": 19.875999999999998, "t": "Online, many people were sure it showed alien craft.", "k": ["Online,"], "w": [17.106, 17.506, 17.745, 18.076, 18.314, 18.553, 18.7, 19.031, 19.316]}, {"a": 19.875999999999998, "b": 20.772, "t": "In 2022,", "k": ["2022,"], "w": [19.926, 20.085]}, {"a": 20.772, "b": 24.906, "t": "even a Navy intelligence official played it in front of the US Congress.", "k": ["intelligence"], "w": [20.822, 21.081, 21.19, 21.449, 22.106, 22.564, 22.923, 23.082, 23.241, 23.55, 23.709, 23.918, 24.077]}, {"a": 24.906, "b": 26.858999999999998, "t": "But here's the catch with those triangles.", "k": ["triangles."], "w": [24.956, 25.143, 25.419, 25.606, 25.881, 26.113, 26.389]}, {"a": 26.858999999999998, "b": 28.492, "t": "They weren't what they looked like.", "k": ["weren't"], "w": [26.909, 27.14, 27.461, 27.692, 27.923, 28.244]}, {"a": 28.492, "b": 31.355999999999998, "t": "In fact, those triangles were never really triangles.", "k": ["triangles."], "w": [28.542, 28.684, 28.982, 29.258, 29.712, 29.943, 30.219, 30.539]}, {"a": 31.355999999999998, "b": 32.937000000000005, "t": "The shape came from the camera:", "k": ["camera:"], "w": [31.406, 31.603, 31.894, 32.138, 32.382, 32.579]}, {"a": 32.937000000000005, "b": 36.396, "t": "light passing through night vision goggles turned into triangles.", "k": ["triangles."], "w": [32.987, 33.277, 33.662, 34.047, 34.337, 34.675, 35.06, 35.397, 35.641]}, {"a": 36.396, "b": 38.899, "t": "Any bright point of light, seen through that setup,", "k": ["through"], "w": [36.446, 36.638, 36.967, 37.25, 37.396, 37.748, 37.985, 38.36, 38.597]}, {"a": 38.899, "b": 40.466, "t": "can show up as a triangle.", "k": ["triangle."], "w": [38.949, 39.141, 39.378, 39.525, 39.671, 39.771]}, {"a": 40.466, "b": 43.866, "t": "And the objects themselves, he said, were most likely drones.", "k": ["themselves,"], "w": [40.516, 40.712, 40.908, 41.29, 41.882, 42.031, 42.344, 42.586, 42.829, 43.164]}, {"a": 43.866, "b": 46.173, "t": "Tell me if that explanation is enough for you.", "k": ["explanation"], "w": [43.916, 44.159, 44.309, 44.459, 44.702, 45.273, 45.423, 45.76, 45.956]}, {"a": 46.173, "b": 49.06, "t": "Follow for the next case.", "k": ["Follow"], "w": [46.223, 46.56, 46.757, 46.953, 47.196]}], "T": {"fin": 49.11, "s_fin": 49.11, "x_real": 1.951, "x_careful": 4.411, "x_sailors": 8.328, "x_filmed": 9.68, "x_2021": 13.419, "x_conf3": 15.028, "x_shot": 16.358, "x_sure": 18.314, "x_alien": 19.031, "x_2022": 20.085, "x_played": 22.564, "x_they": 26.909, "x_never": 29.943, "x_light": 32.987, "x_through": 33.662, "x_turned": 35.06, "x_any": 36.446, "x_seen": 37.748, "x_tri8": 39.771, "x_objects": 40.908, "x_most": 42.586, "x_tell": 43.796, "s_cta": 46.223, "c01b": 2.243, "c02": 7.306, "c03": 12.266, "c04a": 16.986, "c04b": 19.805999999999997, "c05": 24.836, "c06": 31.28