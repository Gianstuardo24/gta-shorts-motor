{"frases": [{"a": 0, "b": 2.1900000000000004, "t": "Never use boiling water for your coffee.", "k": ["boiling"], "w": [0.056, 0.372, 0.586, 1.003, 1.319, 1.533, 1.797]}, {"a": 2.1900000000000004, "b": 4.12, "t": "Lots of people do it every morning,", "k": ["morning,"], "w": [2.24, 2.505, 2.668, 3.035, 3.198, 3.361, 3.676]}, {"a": 4.12, "b": 5.9990000000000006, "t": "but it might be ruining every cup.", "k": ["ruining"], "w": [4.17, 4.384, 4.547, 4.863, 5.026, 5.443, 5.759]}, {"a": 5.9990000000000006, "b": 8.315999999999999, "t": "And the solution might surprise you.", "k": ["solution"], "w": [6.049, 6.263, 6.477, 6.946, 7.261, 7.73]}, {"a": 8.315999999999999, "b": 10.503, "t": "Boiling water feels like the right choice.", "k": ["Boiling"], "w": [8.366, 8.765, 9.067, 9.369, 9.622, 9.827, 10.129]}, {"a": 10.503, "b": 12.356, "t": "Hotter water, stronger coffee.", "k": ["stronger"], "w": [10.553, 10.903, 11.278, 11.726]}, {"a": 12.356, "b": 16.566, "t": "But the National Coffee Association recommends water just below boiling.", "k": ["Association"], "w": [12.406, 12.626, 12.846, 13.328, 13.705, 14.344, 14.93, 15.255, 15.527, 15.852]}, {"a": 16.566, "b": 19.762, "t": "Between 195 and 205 degrees Fahrenheit.", "k": ["195", "205"], "w": [16.616, 17.08, 17.736, 17.973, 18.63, 19.093]}, {"a": 19.762, "b": 21.556, "t": "Water boils at 212.", "k": ["212."], "w": [19.812, 20.162, 20.513, 20.694]}, {"a": 21.556, "b": 23.947, "t": "Hotter than that can pull too much out of the coffee.", "k": ["coffee."], "w": [21.606, 21.91, 22.129, 22.348, 22.525, 22.745, 22.922, 23.141, 23.318, 23.453, 23.63]}, {"a": 23.947, "b": 25.976, "t": "That's when it turns bitter and harsh.", "k": ["That's"], "w": [23.997, 24.259, 24.478, 24.613, 24.874, 25.178, 25.355]}, {"a": 25.976, "b": 28.011, "t": "Now the part almost nobody does right.", "k": ["almost"], "w": [26.026, 26.235, 26.444, 26.703, 27.061, 27.419, 27.678]}, {"a": 28.011, "b": 30.464, "t": "There's a simple fix that could save every cup,", "k": ["There's"], "w": [28.061, 28.419, 28.529, 28.887, 29.096, 29.355, 29.663, 29.922, 30.23]}, {"a": 30.464, "b": 32.646, "t": "and it takes just 30 seconds.", "k": ["30"], "w": [30.514, 30.723, 30.882, 31.191, 31.449, 31.867]}, {"a": 32.646, "b": 35.216, "t": "You don't need a thermometer, or a fancy kettle.", "k": ["thermometer,"], "w": [32.696, 32.887, 33.124, 33.361, 33.461, 34.085, 34.231, 34.331, 34.614]}, {"a": 35.216, "b": 37.876000000000005, "t": "And you don't need to buy more expensive coffee either.", "k": ["expensive"], "w": [35.266, 35.442, 35.617, 35.835, 36.052, 36.186, 36.361, 36.579, 37.005, 37.306]}, {"a": 37.876000000000005, "b": 41.666000000000004, "t": "Just let the water boil, then wait about 30 seconds before you pour.", "k": ["30"], "w": [37.926, 38.162, 38.353, 38.544, 38.825, 39.13, 39.366, 39.602, 39.884, 40.265, 40.638, 40.965, 41.156]}, {"a": 41.666000000000004, "b": 44.306000000000004, "t": "That small wait brings it down to the right range.", "k": ["brings"], "w": [41.716, 41.948, 42.224, 42.456, 42.777, 42.919, 43.151, 43.293, 43.481, 43.757]}, {"a": 44.306000000000004, "b": 45.607, "t": "But don't wait too long.", "k": ["don't"], "w": [44.356, 44.57, 44.835, 45.101, 45.315]}, {"a": 45.607, "b": 48.646, "t": "Below that range, coffee can taste weak and sour.", "k": ["range,"], "w": [45.657, 45.973, 46.238, 46.631, 46.998, 47.213, 47.529, 47.794, 48.008]}, {"a": 48.646, "b": 51.037000000000006, "t": "Tell me if your coffee usually tastes bitter.", "k": ["usually"], "w": [48.696, 48.954, 49.114, 49.273, 49.531, 49.889, 50.297, 50.654]}, {"a": 51.037000000000006, "b": 54.67, "t": "Follow for one coffee curiosity a day.", "k": ["curiosity"], "w": [51.087, 51.445, 51.654, 51.862, 52.22, 52.727, 52.837]}], "T": {"fin": 54.72, "s_fin": 54.72, "x_morning": 3.676, "x_ruin": 5.026, "x_every2": 5.443, "x_and1": 6.049, "x_hotter": 10.553, "x_stronger": 11.278, "x_nat": 12.846, "x_rec": 14.344, "x_195": 17.08, "x_205": 17.973, "x_fahr": 19.