{"frases": [{"a": 0, "b": 1.849, "t": "Your coffee is lying to your brain.", "k": ["coffee"], "w": [0.056, 0.309, 0.659, 0.815, 1.116, 1.272, 1.525]}, {"a": 1.849, "b": 4.4270000000000005, "t": "It feels like energy, but it isn't giving you any.", "k": ["energy,"], "w": [1.899, 2.055, 2.356, 2.609, 3.032, 3.236, 3.392, 3.645, 3.995, 4.199]}, {"a": 4.4270000000000005, "b": 7.136, "t": "Careful, the real trick shows up hours later.", "k": ["Careful,"], "w": [4.477, 4.948, 5.153, 5.405, 5.707, 6.008, 6.164, 6.466]}, {"a": 7.136, "b": 8.661, "t": "From the moment you wake up,", "k": ["moment"], "w": [7.186, 7.444, 7.653, 8.011, 8.219, 8.478]}, {"a": 8.661, "b": 11.505999999999998, "t": "your brain builds up a chemical called adenosine.", "k": ["adenosine."], "w": [8.711, 8.97, 9.278, 9.636, 9.795, 9.904, 10.361, 10.719]}, {"a": 11.505999999999998, "b": 13.709999999999999, "t": "The more it piles up, the sleepier you feel.", "k": ["sleepier"], "w": [11.556, 11.75, 11.989, 12.137, 12.423, 12.639, 12.833, 13.257, 13.451]}, {"a": 13.709999999999999, "b": 15.556, "t": "It's your body's tiredness signal.", "k": ["tiredness"], "w": [13.76, 13.953, 14.193, 14.479, 14.949]}, {"a": 15.556, "b": 18.326, "t": "Caffeine has almost the same shape as that chemical.", "k": ["chemical."], "w": [15.606, 16.024, 16.215, 16.542, 16.733, 16.97, 17.252, 17.397, 17.634]}, {"a": 18.326, "b": 21.506, "t": "So it slips into the same spots in your brain, and blocks them.", "k": ["brain,"], "w": [18.376, 18.514, 18.653, 18.921, 19.146, 19.328, 19.553, 19.821, 19.959, 20.184, 20.517, 20.699, 21.01]}, {"a": 21.506, "b": 23.497999999999998, "t": "The tiredness signal can't get through.", "k": ["tiredness"], "w": [21.556, 21.762, 22.261, 22.613, 22.867, 23.073]}, {"a": 23.497999999999998, "b": 24.886, "t": "And you feel awake.", "k": ["awake."], "w": [23.548, 23.753, 23.959, 24.213]}, {"a": 24.886, "b": 26.941, "t": "Now the part that shows up hours later,", "k": ["later,"], "w": [24.936, 25.141, 25.346, 25.6, 25.853, 26.156, 26.312, 26.615]}, {"a": 26.941, "b": 29.146, "t": "and it's why the crash hits so hard.", "k": ["crash"], "w": [26.991, 27.196, 27.401, 27.606, 27.81, 28.113, 28.367, 28.523]}, {"a": 29.146, "b": 31.214, "t": "Your coffee didn't remove the tiredness.", "k": ["tiredness."], "w": [29.196, 29.454, 29.811, 30.118, 30.475, 30.684]}, {"a": 31.214, "b": 32.526, "t": "It only covered it.", "k": ["covered"], "w": [31.264, 31.422, 31.68, 32.087]}, {"a": 32.526, "b": 36.053000000000004, "t": "While the caffeine sits there, your brain keeps making adenosine.", "k": ["adenosine."], "w": [32.576, 32.893, 33.108, 33.578, 33.844, 34.237, 34.503, 34.82, 35.137, 35.505]}, {"a": 36.053000000000004, "b": 37.776, "t": "It just has nowhere to go.", "k": ["nowhere"], "w": [36.103, 36.267, 36.532, 36.747, 37.166, 37.33]}, {"a": 37.776, "b": 41.096000000000004, "t": "Then the caffeine wears off, and all of it rushes in at once.", "k": ["caffeine"], "w": [37.826, 38.069, 38.265, 38.695, 38.984, 39.251, 39.447, 39.643, 39.792, 39.942, 40.278, 40.428, 40.577]}, {"a": 41.096000000000004, "b": 42.895, "t": "And if you drink coffee every day,", "k": ["coffee"], "w": [41.146, 41.351, 41.507, 41.712, 42.014, 42.365, 42.667]}, {"a": 42.895, "b": 45.494, "t": "your brain adapts by building more of those spots.", "k": ["building"], "w": [42.945, 43.199, 43.501, 43.852, 44.008, 44.456, 44.71, 44.866, 45.168]}, {"a": 45.494, "b": 48.046, "t": "That's why one cup stops feeling like enough.", "k": ["feeling"], "w": [45.544, 45.846, 46.051, 46.255, 46.46, 46.763, 47.162, 47.416]}, {"a": 48.046, "b": 49.813, "t": "So coffee doesn't give you energy.", "k": ["doesn't"], "w": [48.096, 48.254, 48.611, 48.967, 49.224, 49.432]}, {"a": 49.813, "b": 51.886, "t": "It just hides how tired you are.", "k": ["hides"], "w": [49.863, 50.021, 50.279, 50.585, 50.793, 51.1, 51.308]}, {"a": 51.886, "b": 54.377, "t": "Tell me how many cups it takes you to feel awake.", "k": ["awake."], "w": [51.936, 52.182, 52.333, 52.532, 52.777, 53.023, 53.174, 53.467, 53.666, 53.817, 54.063]}, {"a": 54.377, "b": 57.910000000000004, "t": "Follow for one coffee curiosity a day.", "k": ["curiosity"], "w": [54.427, 54.767, 54.966, 55.164, 55.505, 55.987, 56.091]}], "T": {"fin": 57.96, "s_fin": 57.96, "x_tell": 51.816, "s_cta": 54.427, "x_energy": 2.609, "x_isnt": 3.392, "x_careful": 4.477, "x_hours": 6.164, "x_adenosine": 10.719, "x_sleepier": 12.833, "x_signal": 14.949, "x_same": 16.733, "x_slips": 18.653, "x_blocks": 20.699, "x_awake": 24.213, "x_hours7": 26.312, "x_crash": 27.81, "x_remove": 30.118, "x_covered": 31.68, "x_keeps": 34.82, "x_nowhere": 36.747, "x_wears": 38.695, "x_rushes": 39.942, "x_once": 40.577, "x_adapts": 43.501, "x_more": 44.456, "x_enough": 47.416, "x_hides": 50.279, "c02": 7.066, "c03": 11.436, "c04": 15.486, "c05": 18.256, "c06": 21.436, "c07": 24.816, "c08": 29.076, "c09": 32.456, "c10": 37.706, "c11": 41.026, "c12": 47.976, "c13": 51.816}, "marca": "COFFEE, BUT WHY?", "tema": "cafe", "escenas": [{"tipo": "pelicula", "desde": "0", "luz": false, "p27_fija": true, "escala": 1.24, "zoom": [{"k": -1, "s": 1.0, "dur": 0.01, "y": 1200}], "zonas": [{"x0": 100000, "x1": 101300, "cam": 100000, "set": "dc_scoffee21_p01", "entorno": "dc_scoffee21_p01", "transicion": "inicio", "camara": "fija", "acabado": "ninguno", "razon": "línea 1 · gancho"}, {"x0": 102600, "x1": 103900, "cam": 102600, "set": "dc_scoffee21_p02", "entorno": "dc_scoffee21_p02", "transicion": "corte", "camara": "fija", "acabado": "ninguno", "razon": "línea 2", "k": "c02"}, {"x0": 105200, "x1": 106500, "cam": 105200, "set": "dc_scoffee21_p03", "entorno": "dc_scoffee21_p03", "transicion": "corte", "camara": "fija", "acabado": "ninguno", "razon": "línea 3", "k": "c03"}, {"x0": 107800, "x1": 109100, "cam": 107800, "set": "dc_scoffee21_p04", "entorno": "dc_scoffee21_p04", "transicion": "corte", "camara": "fija", "acabado": "ninguno", "razon": "línea 4", "k": "c04"}, {"x0": 110400, "x1": 111700, "cam": 