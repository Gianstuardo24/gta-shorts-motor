MANOS = {"billetesH", "papelesH", "telefonoH", "manosTeclado"}
ANIO = re.compile(r"^(19[5-9]\d|20[0-3]\d)s?\W*$")
ult_corte = {}           # nombre -> ultimo tiempo usado (no repetir antes de 60 s)
anio_prev = [None]


SET_CORTE = {"lab80": ["render", "teclado", "edificio"], "animacion": ["render", "claqueta"], "cineH": ["claqueta", "render"], "despacho80": ["papeles", "telefono", "billetes"],
             "reunion": ["papeles", "telefono", "edificio"], "casona": ["telefono", "papeles"], "bolsaH": ["sube", "billetes"], "servidoresH": ["render", "teclado"],
             "premiacionH": ["claqueta"], "medicoH": ["telefono"], "setTVH": ["claqueta", "telefono"], "restauranteH": ["telefono", "papeles"], "museoH": ["billetes", "papeles"],
             "vitrina": ["edificio", "render"]}


def cortes_set(s, setn):
    return [(n, CORTES[n][0], dict(CORTES[n][2])) for n in SET_CORTE.get(setn, []) if s - ult_corte.get(n, -99) >= 30]


def cortes_posibles(s, L):
    if L < 1.8: return []
    ws = [w for w in PAL if s - 0.1 <= w["i"] < s + 2.2]
    txt = " ".join(w["w"].lower() for w in ws)
    out = []
    for n, (st, kws, op) in CORTES.items():
        if s - ult_corte.get(n, -99) < 30: continue
        if any(re.search(r"(^|\W)" + re.escape(k) + r"(\W|$)", txt) for k in kws): out.append((n, st, dict(op)))
    for w in ws:
        m = ANIO.match(w["w"])
        if m and s - ult_corte.get("anio" + m.group(1), -99) > 60:
            y = int(m.group(1)); out.append(("anio" + m.group(1), "lineaTiempoH", {"anio": y, "desde": anio_prev[0] or y - 6})); break
    return out


def palabras(a, b):
    return " ".join(w["w"].lower() for w in PAL if a <= w["i"] < b)


# ---------- insertos de detalle ----------
XI = max([z["x0"] + 100 for z in e["zonas"] if z["x0"] >= 99000] + [100000]) + 2600
TRD = ["seco", "seco", "luz", "seco", "lineas", "seco"]
ndet = 0


def detalle(s, d, st, op, home):
    global XI, ndet
    e["zonas"].append({"x0": XI - 100, "x1": XI + ANCHO + 100, "set": st, "o": dict(op, k=round(s, 3))})
    tr = TRD[ndet % len(TRD)]; ndet += 1
    e["pan"].append({"k": round(s, 3), "x": XI + 437, "dur": 0.04, "corte": 1, "tr": tr})
    e["pan"].append({"k": round(s + d, 3), "x": home, "dur": 0.04, "corte": 1, "dir": 1, "tr": "seco"})
    mv = R.choice(["acerca", "fijo", "sube", "acerca", "baja"])
    Z = {"acerca": [(1.0, 0.01, 1200), (1.07, d, 1250)], "fijo": [(1.0, 0.01, 1200)], "sube": [(1.07, 0.01, 1290), (1.07, d, 1220)],
         "baja": [(1.07, 0.01, 1220), (1.07, d, 1290)]}[mv]
    for j, (sz, du, y) in enumerate(Z):
        NZ.append({"k": round(s + 0.02 * j, 3), "s": sz, "dur": du, "y": y})
    XI += 2600


def libre_arriba(S, X, Y, s, f, lo, hi):
    """Ningun objeto alto (etiquetas, precios, carteles) puede subir hasta la franja de subtitulos: baja el centro o abre el plano."""
    if S <= 1.0: return S, Y
    for _ in range(6):
        cx = max(lo + 975 / S, min(hi - 975 / S, X)); v0, v1 = cx - 975 / S, cx + 975 / S
        tops = []
        for p in PROPS:
            if not (p["_a"] < f and p["_f"] > s) or not (v0 - 100 < p["x"] < v1 + 100): continue
            al, anc = ALTO.get(p.get("tipo"), (240, "c")); py = p.get("y", SUELO); ps = p.get("s", 1)
            tops.append(py - al * ps if anc == "b" else py - al * ps / 2)
        if not tops: return S, Y
        lim = min(tops) + 300 / S
        if Y <= lim: return S, Y
        if lim >= 1150: return S, lim
        S = max(1.0, S - 0.12)
    return S, Y


ALTO = {"compu85": (660, "b"), "cartel": (340, "b"), "bolsa_dinero": (140, "b"), "cajita": (130, "b"), "trono": (430, "b"), "linterna": (320, "b"),
        "pc": (320, "b"), "tv": (210, "c"), "documento": (300, "c"), "grafico": (210, "c"), "cheque": (130, "c"), "corona": (130, "c")}

# ---------- planificar ----------
NZ, usados, hist, LOG = [], [], [], []
hints = [dict(h, _t=res(h["k"])) for h in e.get("planos_hint", []) if res(h["k"]) is not None]
for d0, d1, vr in ENTRADAS:
    if any(a0 <= d1 + 1.5 and b0 >= d0 for a0, b0 in DURO): continue
    hints += [{"k": d0, "_t": d0, "tipo": "general"}, {"k": d1, "_t": d1, "tipo": "medio", "var": vr, "push": 1}]
hints.sort(key=lambda h: h["_t"])
ult_det, nhol = -9, 0
cuenta = {}
for sg in segs:
    a, b, camx = sg["a"], sg["b"], sg["x"]
    lo, hi = camx - 437, camx - 437 + 1950
    cl = lambda x, s: max(lo + 975 / s, min(hi - 975 / s, x))
    ev = sorted({p["_a"] - 0.05 for p in PROPS if a + 1.2 < p["_a"] < b - 1.0 and lo <= p["x"] <= hi} |
                {kk["_t"] - 0.05 for ac in ACT for kk in ac["keys"] if kk["_t"] and a + 1.2 < kk["_t"] < b - 1.0 and ac["_d"] <= kk["_t"] < ac["_h"]})
    fijos = [h["_t"] - 0.05 for h in hints if a + 0.8 < h["_t"] < b - 1.2]
    cortes, t = [a], a
    while True:
        nxt = [f for f in fijos if f > t + 0.8]
        if nxt and nxt[0] < t + 4.6:
            t = nxt[0]
        else:
            L = R.uniform(2.4, 3.4)
            t = snap(t + L, t + 2.0, min(t + 4.2, b - 1.2), [x for x in ev if x > t + 2.0])
        if t >= b - 1.2: break
        cortes.append(t)
    i = 0
    while i < len(cortes):
        s = cortes[i]; f = cortes[i + 1] if i + 1 < len(cortes) else b; L = f - s
        vis = visibles(s + 0.1, lo, hi)
        hint = next((h for h in hints if abs(h["_t"] - 0.05 - s) < 0.06 or (i == 0 and a - 0.2 <= h["_t"] < a + 0.85)), None)
        duro = any(d0 < f and d1 > s for d0, d1 in DURO)
        aparece = [p for p in PROPS if s - 0.3 <= p["_a"] < s + 1.0 and lo <= p["x"] <= hi]
        pv = [p for p in PROPS if p["_a"] <= s + 0.2 < p["_f"] and lo <= p["x"] <= hi]
        prev = hist[-1] if hist else None
        # actor "activo": el que acaba de cambiar de accion (o la cambia pronto)
        def activo():
            best, bt = None, -1e9
            for ac in vis:
                for kk in ac["keys"]:
                    if kk["_t"] is not None and kk["_t"] <= s + 1.5 and kk["_t"] > bt and kk["_t"] >= s - 3: best, bt = ac, kk["_t"]
            return best or (vis[(len(hist) // 2) % len(vis)] if vis else None)
        foco = activo()
        if hint:
            tipo = hint["tipo"]; foco = next((ac for ac in vis if ac.get("var") == hint.get("var")), foco)
        elif duro:
            entra = any(d0 < f and d0 + 3.0 > s for d0, d1 in NUMS) or any(d0 < f and d1 > s for d0, d1 in DURO if (d0, d1) not in NUMS)
            cps = [] if entra or prev == "detalle" or (f >= b - 0.01 and sg["sale"]) else cortes_posibles(s, L)
            if cps and R.random() < 0.75: tipo = "detalle"
            else: tipo = "recorre" if prev != "recorre" and L > 2.0 else "general"
        elif i == 0 and sg["llega"] == "paneo":
            tipo = "general"
        elif aparece:
            tipo = R.choices(["objeto", "general"], [3, 1])[0]
        else:
            c = {"medio": 3, "primer": 2, "dos": 2, "holandes": 1.3, "camina": 2.2, "objeto": 1.6, "general": 1.0}
            if len(vis) < 2 or abs(estado(vis[0], s)[1] - estado(vis[-1], s)[1]) > 1950 / 1.2 - 300: c.pop("dos", None)
            if not vis: [c.pop(x, None) for x in ("medio", "primer", "holandes", "camina", "dos")]
            if not pv: c.pop("objeto", None)
            cps = cortes_posibles(s, L) or (cortes_set(s, sg["set"]) if L >= 1.8 and R.random() < 0.8 else [])
            if (i == 0 and sg["vuelve"]) or (f >= b - 0.01 and sg["sale"]) or (hist and hist[-1] == "detalle"): cps = []   # nunca inserto pegado a otro inserto
            libres = []
            for ac in vis:
                cur, x, mov = estado(ac, s)
                if mov or cur.get("objeto") or cur.get("pose") in ("sentado", "juega") or cur.get("fx"): continue
                if any(kk["_t"] and s - 0.3 < kk["_t"] < f + 0.2 for kk in ac["keys"]): continue
                libres.append((ac, cur, x))
            if not libres or L < 1.8: c.pop("camina", None)
            if prev: c.pop(prev, None)
            if prev in ("medio", "holandes"): c.pop("holandes" if prev == "medio" else "medio", None)
            if len(hist) > 1 and {hist[-1], hist[-2]} <= {"medio", "primer", "holandes"}:
                for x in ("medio", "primer", "holandes"): c.pop(x, None)
            for x in c: c[x] = c[x] / (1 + 0.04 * cuenta.get(x, 0))
            if cps and R.random() < 0.92: tipo = "detalle"
            else:
                tipo = R.choices(*zip(*c.items()))[0] if c else "general"
        hist.append(tipo); cuenta[tipo] = cuenta.get(tipo, 0) + 1
        LOG.append(f"{s:7.2f}-{f:7.2f} {tipo:9s} foco={foco.get('var') if foco else None} vis={[v.get('var') for v in vis]} seg={sg['a']:.2f}")
        ax = estado(foco, s)[1] if foco else lo + 975
        push = (hint and hint.get("push")) or R.random() < 0.38
        if tipo == "detalle":
            ult_det = len(hist)
            n, st, op = R.choice(cps); ult_corte[n] = s
            if n.startswith("anio"): anio_prev[0] = op["anio"]
            if st in MANOS: op["manga"] = (foco or (vis[0] if vis else {})).get("camisa", "#455a64")
            d = round(min(2.8, max(1.8, L)), 2)
            if L > d + 1.4:          # vuelve a la escena en una pausa y sigue con otro plano
                r = snap(s + 2.3, s + 1.9, s + 2.8)
                cortes.insert(i + 1, r); d = r - s
            else:
                d = L
            detalle(s, d, st, op, camx)
            LOG[-1] += " " + n
            i += 1; continue
        if tipo == "camina":
            ac, cur, rest = R.choice(libres); dr = cur.get("dir", 1)
            x0 = max(lo + 160, min(hi - 160, rest - dr * 400))
            if abs(x0 - rest) >= 220:
                D = round(min(2.7, max(1.4, L - 0.3)), 2)
                nk = {"k": round(s, 3), "x": round(x0), "y": SUELO, "a": [rest, SUELO], "dur": D, "ease": "eio", "dir": dr,
                      "pose": cur.get("pose", "parado"), "cara": cur.get("cara", "feliz"), "_t": s}
                pos = next((n for n, kk in enumerate(ac["keys"]) if (kk["_t"] or 0) > s), len(ac["keys"]))
                ac["keys"].insert(pos, nk)
                NZ.append({"k": round(s, 3), "s": 1.3, "x": round(cl(x0 + dr * 150, 1.3)), "y": 1330, "dur": 0.01})
                NZ.append({"k": round(s + 0.03, 3), "s": 1.3, "x": round(cl(rest + dr * 150, 1.3)), "y": 1330, "dur": D})
                i += 1; continue
            tipo = "medio"; hist[-1] = "medio"
        r = 0
        if tipo == "holandes":
            nhol += 1; r = 0.045 if nhol % 2 else -0.045
        if tipo == "recorre":
            nrec = cuenta.get("recorre", 0); dx = 110 if nrec % 2 else -110
            NZ.append({"k": round(s, 3), "s": 1.12, "x": round(cl(lo + 975 - dx, 1.12)), "y": 1230, "dur": 0.01})
            NZ.append({"k": round(s + 0.03, 3), "s": 1.12, "x": round(cl(lo + 975 + dx, 1.12)), "y": 1230, "dur": round(L - 0.1, 2)})
            i += 1; continue
        if tipo == "objeto":      # la camara va al objeto, pero sin que su parte alta (etiquetas, precios) llegue a los subtitulos
            p = (aparece or pv)[0]; ps = p.get("s", 1)
            al, anc = ALTO.get(p.get("tipo"), (240, "c")); py = p.get("y", SUELO)
            top, bot = (py - al * ps, py) if anc == "b" else (py - al * ps / 2, py + al * ps / 2)
            S = max(1.0, min(1.38, 0.9 * 880 / max(1, bot - top)))
            lo_y, hi_y = bot - 580 / S + 30, top + 300 / S
            Y = max(1100, min(1500, (lo_y + hi_y) / 2 if lo_y > hi_y else min(hi_y, max(lo_y, (top + bot) / 2))))
            X = p["x"]
        elif tipo == "dos" and len(vis) >= 2:
            xs = [estado(ac, s)[1] for ac in vis]; S, X, Y = 1.2, (min(xs) + max(xs)) / 2, 1350
        else:
            S, X, Y = {"general": (1.0, lo + 975, 1200), "medio": (1.32, ax, 1330), "holandes": (1.32, ax, 1330),
                       "primer": (1.8, ax, 1265), "dos": (1.32, ax, 1330)}.get(tipo, (1.0, lo + 975, 1200))
        S, Y = libre_arriba(S, X, Y, s, f, lo, hi)
        z = {"k": round(s, 3), "s": S, "x": round(cl(X, S)), "y": round(Y), "dur": 0.01}
