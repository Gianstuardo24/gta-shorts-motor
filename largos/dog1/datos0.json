.487, 219.612]}, {"a": 220.28, "b": 222.022, "t": "Keep in mind, it was a survey,", "k": ["survey,"], "w": [220.33, 220.601, 220.768, 221.117, 221.284, 221.503, 221.618]}, {"a": 222.022, "b": 225.23, "t": "so it shows how people feel, not a lab measurement.", "k": ["measurement."], "w": [222.072, 222.239, 222.406, 222.729, 222.948, 223.323, 223.673, 223.892, 224.007, 224.226]}, {"a": 225.23, "b": 227.41, "t": "Signal number six: the zoomies.", "k": ["zoomies."], "w": [225.28, 225.67, 226.059, 226.368, 226.595]}, {"a": 227.41, "b": 231.91, "t": "Suddenly, your dog runs in circles, like it is being chased by nothing.", "k": ["Suddenly,"], "w": [227.46, 228.045, 228.329, 228.559, 228.843, 229.018, 229.548, 229.832, 230.007, 230.182, 230.521, 230.915, 231.09]}, {"a": 231.91, "b": 236.03, "t": "Experts call these frenetic random activity periods, or FRAPs.", "k": ["random"], "w": [231.96, 232.431, 232.73, 233.086, 233.614, 234.028, 234.557, 235.114, 235.298]}, {"a": 236.03, "b": 237.742, "t": "They often happen after a bath,", "k": ["happen"], "w": [236.08, 236.344, 236.659, 237.025, 237.34, 237.452]}, {"a": 237.742, "b": 240.45999999999998, "t": "after being let out, or when you come home.", "k": ["after"], "w": [237.792, 238.107, 238.422, 238.636, 238.925, 239.088, 239.352, 239.565, 239.83]}, {"a": 240.45999999999998, "b": 241.80599999999998, "t": "So why do they happen?", "k": ["happen?"], "w": [240.51, 240.686, 240.917, 241.092, 241.378]}, {"a": 241.80599999999998, "b": 246.184, "t": "Most experts think it is a way to let out energy that has been building up,", "k": ["building"], "w": [241.856, 242.142, 242.592, 242.933, 243.109, 243.284, 243.405, 243.636, 243.812, 244.042, 244.273, 244.669, 244.954, 245.185, 245.471, 245.976]}, {"a": 246.184, "b": 249.08999999999997, "t": "or nervous energy after something stressful.", "k": ["stressful."], "w": [246.234, 246.41, 246.861, 247.256, 247.597, 248.157]}, {"a": 249.08999999999997, "b": 252.37099999999998, "t": "A bath is 