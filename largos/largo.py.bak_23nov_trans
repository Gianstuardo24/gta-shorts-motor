"""Constructor de videos LARGOS horizontales (escena_h.html).
Cada 'tramo' es una zona de 2200 px del mundo; la camara va a i*2200 y se ve el tramo entero
(coordenada de pantalla sx 0..1950, centro ~975). Los momentos de cada tramo se nombran b<i><nombre>."""
import json, re

ANCHO = 2200
SUELO = 1700


class Tramo:
    def __init__(self, L, i, set_, luz=None, neon=None):
        self.L, self.i = L, i
        self.key = f"b{i}"
        self.x0 = i * ANCHO - 437
        self.f0 = len(L.frases)
        z = {"x0": self.x0 - 100, "x1": self.x0 + ANCHO + 100, "set": set_}
        if i > 0:
            z["k"] = self.key
        if luz: z["luz"] = luz
        if neon: z["neon"] = neon
        L.zonas.append(z)
        if i > 0:
            L.pan.append({"k": self.key, "x": i * ANCHO, "dur": 1.0})
        L.M.append([self.key, self.f0, None])
        self.props, self.actores = [], []

    def X(self, sx):
        return round(self.x0 + sx)

    def dice(self, *frases):
        for f in frases:
            if isinstance(f, tuple):
                self.L.frases.append(f[0]); self.L.voz.append(f[1])
            else:
                self.L.frases.append(f); self.L.voz.append(self.L.vozde(f))
        return self

    def m(self, nombre, frase, patron=None):
        """momento: frase relativa al tramo (0 = primera frase del tramo)."""
        k = f"{self.key}{nombre}"
        self.L.M.append([k, self.f0 + frase, patron])
        return k

    def k(self, nombre):
        return f"{self.key}{nombre}" if nombre not in ("", None) else self.key

    def prop(self, tipo, sx, y=SUELO, s=1.0, k=None, fin=None, **o):
        p = {"tipo": tipo, "x": self.X(sx), "y": y, "s": s, "k": k or self.key}
        if fin: p["fin"] = fin
        p.update(o)
        if "mov" in p:
            p["mov"] = [{"k": m[0], "x": self.X(m[1]), "y": m[2]} for m in p["mov"]]
        self.props.append(p)
        return p

    def actor(self, base, keys, desde=None, hasta=None, **o):
        a = dict(base); a.update(o)
        objs = {kk.get("objeto") for kk in keys if kk.get("objeto")}
        if "os" not in o and objs:                 # objeto en la mano: tamano segun el tipo
            a["os"] = min({"documento": 0.42, "cheque": 0.5, "billetes": 0.55, "cajita": 0.6, "pelota": 0.9}.get(x, 0.6) for x in objs)
        a["desde"] = desde or self.key
        if hasta: a["hasta"] = hasta
        ks = []
        for kk in keys:
            kk = dict(kk)
            kk["x"] = self.X(kk.get("x", 975)); kk.setdefault("y", SUELO)
            if "a" in kk: kk["a"] = [self.X(kk["a"][0]), kk["a"][1]]
            kk.setdefault("k", self.key)
            ks.append(kk)
        a["keys"] = ks
        self.actores.append(a)
        return a


class Largo:
    def __init__(self, reemplazos=()):
        self.frases, self.voz, self.M = [], [], []
        self.zonas, self.pan, self.tramos = [], [], []
        self.titulos, self.chips, self.numeros, self.burbujas, self.zoom, self.sacudidas, self.sfx = [], [], [], [], [], [], []
        self.capitulos = {}
        self.reemplazos = list(reemplazos)

    def vozde(self, f):
        for a, b in self.reemplazos:
            f = re.sub(a, b, f)
        return f

    def tramo(self, set_, luz=None, neon=None, capitulo=None):
        t = Tramo(self, len(self.tramos), set_, luz, neon)
        self.tramos.append(t)
        if capitulo:
            self.capitulos[t.key if t.i else "0"] = capitulo
        return t

    def titulo(self, k, texto, c="amar", grande=False, fin=None):
        d = {"k": k, "texto": texto, "c": c}
        if grande: d["grande"] = True
        if fin: d["fin"] = fin
        self.titulos.append(d)

    def chip(self, k, texto, c="verde", fin=None):
        d = {"k": k, "texto": texto, "c": c}
        if fin: d["fin"] = fin
        self.chips.append(d)

    def numero(self, k, n, etq, pre="", suf="", c="amar", fin=None, y=None):
        d = {"k": k, "n": n, "pre": pre, "suf": suf, "c": c, "etq": etq}
        if fin: d["fin"] = fin
        if y: d["y"] = y
        self.numeros.append(d)

    def burbuja(self, k, de_actor, texto, fin=None, dx=0):
        self.burbujas.append({"k": k, "de": de_actor, "texto": texto, "fin": fin, "dx": dx})

    def inserto(self, k_in, k_out, set_="vitrina", o=None, props=(), whoosh=True, mov=None):
        """Corte a un plano de detalle sin personajes entre k_in y k_out (zona lejana del mundo).
        Si k_out es el inicio de un tramo, ese paneo se vuelve corte; si no, vuelve al tramo de k_in.
        props: x/y en coordenadas de tramo (sx 0..1950, centro ~975)."""
        self._ins = getattr(self, "_ins", 0) + 1
        XI = 100000 + self._ins * 2600
        self.__dict__.setdefault("ins_k", []).append((k_in, k_out))                      # x0 'de tramo' de la zona del inserto
        z = {"x0": XI - 100, "x1": XI + ANCHO + 100, "set": set_}
        o = dict(o or {}); o.setdefault("k", k_in); z["o"] = o
        self.zonas.append(z)
        self.pan.append({"k": k_in, "x": XI + 437, "dur": 0.04, "corte": 1})
        ex = [p for p in self.pan if p["k"] == k_out and not p.get("corte")]
        if ex:
            ex[0].update({"dur": 0.04, "corte": 1, "dir": 1})
        else:
            mt = re.match(r"^b(\d+)", str(k_in))
            self.pan.append({"k": k_out, "x": (int(mt.group(1)) if mt else 0) * ANCHO, "dur": 0.04, "corte": 1, "dir": 1})
        # movimiento de cámara VARIADO (para que no se note un patrón): se elige en ciclo o con mov=...
        MOVS = ["acerca", "fijo", "aleja", "paneo", "golpe", "sube", "acerca", "baja", "aleja", "fijo"]
        mov = mov or MOVS[(self._ins * 7) % len(MOVS)]
        cx = XI + 977
        Z = {"acerca": [{"k": k_in, "s": 1.0, "dur": 0.01}, {"k": k_in, "s": 1.06, "dur": 7, "y": 1250}],
             "aleja":  [{"k": k_in, "s": 1.09, "dur": 0.01, "y": 1250}, {"k": k_in, "s": 1.0, "dur": 4.5}],
             "paneo":  [{"k": k_in, "s": 1.08, "dur": 0.01, "x": cx - 90, "y": 1260}, {"k": k_in, "s": 1.08, "dur": 7, "x": cx + 90, "y": 1260}],
             "sube":   [{"k": k_in, "s": 1.08, "dur": 0.01, "y": 1290}, {"k": k_in, "s": 1.08, "dur": 6, "y": 1220}],
             "baja":   [{"k": k_in, "s": 1.08, "dur": 0.01, "y": 1220}, {"k": k_in, "s": 1.08, "dur": 6, "y": 1290}],
             "golpe":  [{"k": k_in, "s": 1.0, "dur": 0.01}, {"k": f"{k_in}+0.45", "s": 1.09, "dur": 0.22, "y": 1260}],
             "fijo":   [{"k": k_in, "s": 1.0, "dur": 0.01}]}[mov]
        self.zoom += Z + [{"k": k_out, "s": 1.0, "dur": 0.01}]
        mt = re.match(r"^b(\d+)", str(k_in)); t = self.tramos[int(mt.group(1))] if mt else self.tramos[0]
        for p in props:
            p = dict(p); p["x"] = XI + p.get("x", 975); p.setdefault("y", SUELO)
            p.setdefault("k", k_in); p.setdefault("fin", k_out); p.setdefault("z", 1800)
            t.props.append(p)
        if whoosh:   # sonidos de entrada/salida variados; a veces corte seco
            W = ["extra/Whip_Whoosh_BW.11026.wav", "extra/MODE_BE2_fx_foley_whoosh_03.wav", "extra/WhipWhooshHeavy_SFXB.1080.wav", None,
                 "extra/MODE_BE2_fx_foley_whoosh_04.wav"]
            wi, wo = W[self._ins % len(W)], W[(self._ins * 3 + 1) % len(W)]
            if wi: self.sfx.append({"f": wi, "k": k_in, "off": -0.06, "dur": 0.3, "g": 0.10})
            if wo: self.sfx.append({"f": wo, "k": k_out, "off": -0.05, "dur": 0.3, "g": 0.09})

    def planos_personaje(self, ciclo=None, semilla=7):
        """Encuadres variados por frase (desde la 2a), elegidos al azar con semilla fija y sin repetir seguido:
        general, medio, primer plano, de a dos, holandes (inclinado), camina (el personaje cruza y la camara lo sigue)
        y detalle (corte a manos haciendo algo: teclado, telefono, papeles, billetes, segun lo que dice la frase).
        Vuelve a plano general en frases con prop nuevo, cifra, globo o titulo grande. Llamar despues de armar los tramos."""
        import random
        R = random.Random(semilla)
        mf = {m[0]: m[1] for m in self.M}
        base = lambda k: re.split(r"[+-]\d", str(k))[0]
        ocup, ini, pini, duro = set(), set(), {}, set()     # duro: cifra/titulo grande/globo (plano general obligado); pini: props que aparecen en cada frase; ocup: frases con algo en pantalla; ini: frases donde ese algo APARECE
        for t in self.tramos:
            for p in t.props:
                f1 = mf.get(base(p.get("k", t.key)))
                if f1 is None: continue
                f2 = mf.get(base(p["fin"]), f1) if p.get("fin") else f1
                ocup.update(range(f1, max(f1, f2) + 1)); ini.add(f1)
                if p.get("x") is not None and p.get("x", 0) < 99000: pini.setdefault(f1, []).append(p)
        for nn in self.numeros:
            if base(nn["k"]) in mf: ocup.add(mf[base(nn["k"])]); ini.add(mf[base(nn["k"])]); duro.add(mf[base(nn["k"])])
        for tt in self.titulos:
            if tt.get("grande") and base(tt["k"]) in mf: ocup.add(mf[base(tt["k"])]); ini.add(mf[base(tt["k"])]); duro.add(mf[base(tt["k"])])
        for bb in self.burbujas:
            if base(bb.get("k", "")) in mf: ocup.add(mf[base(bb["k"])]); ini.add(mf[base(bb["k"])]); duro.add(mf[base(bb["k"])])
        cubre = set()
        for ki, ko in getattr(self, "ins_k", []):
            fi, fo = mf.get(base(ki)), mf.get(base(ko))
            if fi is None: continue
            fo = fi + 1 if fo is None or fo <= fi else fo
            if "+" in str(ko): fo = max(fo, fi + 2)
            cubre.update(range(fi, fo + 1))
        KW = {"billetesH": ["million", "billion", "money", "dollars", "cash", "paid", "pay", "price", "bought", "worth", "$"],
              "papelesH": ["deal", "contract", "signed", "sign", "agreement", "lawyer", "divorce", "terms", "shares", "stock", "sell", "sale"],
              "telefonoH": ["call", "called", "phone", "offer", "offered", "asked", "told", "news", "warned"],
              "manosTeclado": ["computer", "computers", "software", "code", "render", "pixel", "machine", "program", "tools", "animated", "animation"]}
        PESO = {"medio": 3, "primer": 2, "general": 1.5, "dos": 2, "holandes": 1.5, "camina": 2.2, "detalle": 3.6}
        hist, ult_det, nhol = [], -9, 0
        fr = lambda t, k: t.f0 if k == t.key else mf.get(base(k))
        for i, t in enumerate(self.tramos):
            f_fin = self.tramos[i + 1].f0 if i + 1 < len(self.tramos) else len(self.frases)
            acts = [a for a in t.actores if a.get("desde") == t.key and a.get("keys")]
            xs = [a["keys"][0]["x"] for a in acts]
            if i > 0: self.zoom.append({"k": t.key, "s": 1.0, "dur": 0.01})
            if not xs: continue
            lo, hi = t.X(0), t.X(1950)
            for j in range(t.f0 + 1, f_fin):
                if j in cubre: continue
                key = f"{t.key}f{j - t.f0}"; self.M.append([key, j, None])
                txt = self.frases[j].lower(); nw = len(txt.split())
                if j in duro or (j in ini and j not in pini):
                    tipo = "general"
                elif j in ini:      # aparece un objeto: plano abierto o la camara va al objeto (el objeto es protagonista)
                    c = {"general": 1.5, "objeto": 2.6}
                    if hist: c.pop(hist[-1], None)
                    tipo = R.choices(*zip(*c.items()))[0] if c else "general"
                else:
                    c = dict(PESO)
                    if j in ocup:      # algo que ya aparecio sigue en pantalla: solo plano abierto, corte a detalle o caminar en plano abierto
                        c = {"general": 2, "detalle": 2.6, "camina": 2.2}
                    if len(xs) < 2: c.pop("dos", None)
                    det = [s for s, ws in KW.items() if any(re.search(r"(^|\W)" + re.escape(w) + r"(\W|$)", txt) for w in ws)]
                    if not det or nw < 7 or len(hist) - ult_det < 3: c.pop("detalle", None)
                    # caminar: actor libre en esta frase (sin cambio de pose propio, sin objeto, de pie)
                    libre = []
                    for a in acts:
                        prev = [kk for kk in a["keys"] if (fr(t, kk.get("k", t.key)) or 0) < j]
                        if not prev or any(fr(t, kk.get("k", t.key)) == j for kk in a["keys"]): continue
                        pv = prev[-1]
                        if pv.get("objeto") or pv.get("pose") in ("sentado", "juega") or pv.get("fx"): continue
                        libre.append((a, pv))
                    if not libre or nw < 5: c.pop("camina", None)
                    if hist: c.pop(hist[-1], None)
                    if len(hist) > 1 and hist[-1] == hist[-2] == "general": c.pop("general", None)
                    tipo = R.choices(*zip(*c.items()))[0] if c else "general"
                hist.append(tipo)
                ax = xs[(len(hist) // 2) % len(xs)]
                cl = lambda x, s: max(lo + 975 / s, min(hi - 975 / s, x))
                if tipo == "detalle":
                    ult_det = len(hist)
                    usados = getattr(self, "_det_usados", [])
                    st = R.choice([x for x in det if x not in usados[-2:]] or det); a0 = acts[0]
                    self._det_usados = usados + [st]
                    dur = round(min(2.1, max(1.5, nw / 3.1 * 0.6)), 1)
                    self.inserto(key, f"{key}+{dur}", st, {"manga": a0.get("camisa", "#455a64")}, whoosh=False)
                    continue
                if tipo == "camina":
                    a, pv = R.choice(libre)
                    rest = pv["a"][0] if pv.get("a") else pv["x"]; d = pv.get("dir", 1)
                    x0 = max(t.X(160), min(t.X(1790), rest - d * 400))
                    if abs(x0 - rest) < 220: tipo = "medio"
                    else:
                        D = round(min(2.8, max(1.6, nw / 3.1 * 0.8)), 2)
                        nk = {"k": key, "x": x0, "y": SUELO, "a": [rest, SUELO], "dur": D, "ease": "eio", "dir": d,
                              "pose": pv.get("pose", "parado"), "cara": pv.get("cara", "feliz")}
                        pos = next((n for n, kk in enumerate(a["keys"]) if (fr(t, kk.get("k", t.key)) or 0) > j), len(a["keys"]))
                        a["keys"].insert(pos, nk)
                        if j in ocup:     # plano abierto: corte leve (para que el salto de posicion sea un corte) y camara quieta
                            self.zoom.append({"k": key, "s": 1.06, "x": round(cl(t.X(975), 1.06)), "y": 1220, "dur": 0.01})
                        else:
                            self.zoom.append({"k": key, "s": 1.3, "x": round(cl(x0 + d * 140, 1.3)), "y": 1330, "dur": 0.01})
                            self.zoom.append({"k": f"{key}+0.03", "s": 1.3, "x": round(cl(rest + d * 140, 1.3)), "y": 1330, "dur": D})
                        continue
                if tipo == "objeto":
                    p = pini[j][0]; ps = p.get("s", 1)
                    yo = max(1150, min(1420, p.get("y", SUELO) - 110 * ps))
                    self.zoom.append({"k": key, "s": 1.38, "x": round(cl(p["x"], 1.38)), "y": round(yo), "dur": 0.5})
                    continue
                if tipo == "dos" and len(xs) < 2: tipo = "medio"
                r = 0
                if tipo == "holandes":
                    nhol += 1; r = 0.045 if nhol % 2 else -0.045; tipo = "medio"
                s, x, y = {"general": (1.0, t.X(975), 1200), "medio": (1.32, ax, 1330), "primer": (1.8, ax, 1265),
                           "dos": (1.2, (min(xs) + max(xs)) / 2, 1350)}[tipo]
                z = {"k": key, "s": s, "x": round(cl(x, s)), "y": y, "dur": 0.55}
                if r: z["r"] = r
                self.zoom.append(z)
        self.planos_usados = hist

    def variar_transiciones(self):
        """Cambios de tramo e insertos con transiciones distintas (no siempre paneo + whoosh)."""
        TT = ["desliza", "barrido", "desliza", "luz", "desliza", "iris", "desliza", "barrido"]   # fluidas (23-nov)
        setx = {round(z["x0"] + 537): z.get("set") for z in self.zonas if z["x0"] < 99000}
        TI = ["seco", "lineas", "seco", "luz", "seco", "iris"]            # sin flash blanco, papel ni tinta (23-nov)
        nt = ni = 0
        for p in self.pan:
            if p.get("tr"): continue
            if p.get("corte"):
                p["tr"] = TI[ni % len(TI)]; ni += 1
            elif setx.get(p["x"]) and setx.get(p["x"]) == setx.get(p["x"] - ANCHO):
                p["dur"] = 1.0                 # mismo lugar: la camara se desliza suave, sin barrido
            else:
                tp = TT[nt % len(TT)]; nt += 1
                if tp == "barrido": p.update({"dur": 0.3, "tr": "lineas"})
                elif tp != "desliza": p.update({"dur": 0.04, "corte": 1, "tr": tp})
                else: p["dur"] = 0.55          # paneo mas rapido entre escenarios

    def armar(self, meta, cola=18.0, final=None):
        n = len(self.tramos)
        props, actores = [], []
        for j, t in enumerate(self.tramos):
            sig = self.tramos[j + 1].key if j + 1 < n else "s_end"
            for p in t.props:
                p.setdefault("fin", sig)
                props.append(p)
            for a in t.actores:
                a.setdefault("hasta", sig)
                actores.append(a)
        # indices de actores para burbujas: se resuelven por objeto
        for b in self.burbujas:
            if isinstance(b.get("de"), dict):
                b["de"] = actores.index(b["de"])
            if b.get("fin") is None:
                b.pop("fin", None)
        for c in self.titulos + self.chips + self.numeros:
            if "fin" not in c:                      # termina al empezar el tramo siguiente al suyo
                mt = re.match(r"^b(\d+)", str(c["k"]))
                if mt:
                    j = int(mt.group(1))
                    c["fin"] = self.tramos[j + 1].key if j + 1 < n else "s_end"
        E = {"momentos": self.M + [["s_end", len(self.frases) - 1, None]],
             "escenas": [{"tipo": "pelicula", "desde": "0", "escala": 1.35, "zonas": self.zonas, "pan": self.pan,
                          "props": props, "actores": actores, "burbujas": self.burbujas, "numeros": self.numeros,
                          "zoom": self.zoom, "sacudidas": self.sacudidas, "titulos": self.titulos, "chips": self.chips},
                         dict({"tipo": "finalH", "desde": "s_end"}, **(final or {}))],
             "sfx": self.sfx, "cola": cola, "cta": "SUBSCRIBE"}
        g = dict(meta)
        g.update({"frases": self.frases, "frases_voz": self.voz, "escena": E, "capitulos": self.capitulos})
        return g
