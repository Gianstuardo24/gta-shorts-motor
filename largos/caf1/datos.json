006, 220.406, 220.63, 220.925, 221.43, 221.865, 222.3]}, {"a": 223.2, "b": 225.79999999999998, "t": "Think of it as a smaller, stronger latte.", "k": ["smaller,"], "w": [223.25, 223.564, 223.726, 223.888, 224.051, 224.162, 224.654, 225.12]}, {"a": 225.79999999999998, "b": 230.26999999999998, "t": "And drink number nine is the biggest of the milk drinks: the latte.", "k": ["biggest"], "w": [225.85, 226.092, 226.45, 226.865, 227.165, 227.35, 227.592, 228.065, 228.25, 228.492, 228.792, 229.294, 229.536]}, {"a": 230.26999999999998, "b": 234.61999999999998, "t": "Its full name is caffè latte, which simply means coffee and milk.", "k": ["latte,"], "w": [230.32, 230.563, 230.863, 231.164, 231.349, 231.707, 232.152, 232.51, 232.926, 233.284, 233.7, 233.943]}, {"a": 234.61999999999998, "b": 239.69, "t": "It is mostly steamed milk, with a shot of espresso and a thin layer of foam,", "k": ["espresso"], "w": [234.67, 234.87, 235.07, 235.519, 236.031, 236.449, 236.774, 236.911, 237.236, 237.436, 238.01, 238.272, 238.41, 238.734, 239.122, 239.321]}, {"a": 239.69, "b": 243.32, "t": "which is why it is the softest drink on the menu.", "k": ["softest"], "w": [239.74, 240.127, 240.327, 240.589, 240.789, 240.988, 241.251, 241.763, 242.15, 242.349, 242.612]}, {"a": 243.32, "b": 246.88899999999998, "t": "Fun fact: if you go to Italy and just ask for a latte,", "k": ["latte,"], "w": [243.37, 243.626, 244.034, 244.229, 244.484, 244.679, 244.874, 245.252, 245.508, 245.824, 246.08, 246.336, 246.47]}, {"a": 246.88899999999998, "b": 249.60999999999999, "t": "you might get a glass of plain milk.", "k": ["might"], "w": [246.939, 247.195, 247.572, 247.828, 247.962, 248.339, 248.534, 248.912]}, {"a": 249.60999999999999, "b": 253.23, "t": "Drink number ten adds one more ingredient: chocolate.", "k": ["ingredient:"], "w": [249.66, 250.019, 250.437, 250.68, 250.981, 251.225, 251.526, 252.262]}, {"a": 253.23, "b": 257.988, "t": "A mocha is basically a latte with chocolate, and its name comes from Moc